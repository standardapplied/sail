<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>ai.singlr</groupId>
    <artifactId>sail</artifactId>
    <version>0.39.1</version>
    <packaging>pom</packaging>

    <modules>
        <module>sail-core</module>
        <module>sail-harness</module>
        <module>sail-infra</module>
    </modules>

    <developers>
        <developer>
            <name>Standard Applied Intelligence Labs</name>
            <organization>Standard Applied Intelligence Labs</organization>
            <organizationUrl>https://github.com/standardapplied/sail</organizationUrl>
        </developer>
    </developers>

    <properties>
        <picocli-version>4.7.7</picocli-version>
        <snakeyaml-engine-version>3.1.1</snakeyaml-engine-version>
        <junit-version>6.0.2</junit-version>

        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <maven.compiler.release>25</maven.compiler.release>

        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <sail.it.requireIncus>false</sail.it.requireIncus>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit-version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>info.picocli</groupId>
                <artifactId>picocli</artifactId>
                <version>${picocli-version}</version>
            </dependency>
            <dependency>
                <groupId>org.snakeyaml</groupId>
                <artifactId>snakeyaml-engine</artifactId>
                <version>${snakeyaml-engine-version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
                <configuration>
                    <argLine>
                        @{argLine}
                        -Duser.timezone=UTC
                        --add-opens java.base/java.util=ALL-UNNAMED
                        --add-opens java.base/java.lang=ALL-UNNAMED
                    </argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>3.2.1</version>
                <configuration>
                    <java>
                        <googleJavaFormat>
                            <version>1.27.0</version>
                            <style>GOOGLE</style>
                        </googleJavaFormat>
                        <importOrder>
                            <order>\#,</order>
                        </importOrder>
                        <removeUnusedImports>
                            <engine>cleanthat-javaparser-unnecessaryimport</engine>
                        </removeUnusedImports>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <id>spotless-check</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.14</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>coverage-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <!--
                                        Ratchet: each minimum sits just under the weakest module's
                                        actual for that counter, all currently bound by sail-infra
                                        (~0.65 line / 0.59 branch / 0.79 method / 0.95 class) so the
                                        current bar is locked in and any regression fails the build.
                                        Raise these as coverage climbs toward 100%.
                                    -->
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.64</minimum>
                                        </limit>
                                        <limit>
                                            <counter>METHOD</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.79</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.59</minimum>
                                        </limit>
                                        <limit>
                                            <counter>CLASS</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.95</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>ai.singlr.sail.api.*</include>
                                    </includes>
                                    <!--
                                        Streaming I/O classes carry OS-level error branches
                                        (NIO accept failures, half-closed sockets, slow-client
                                        write timeouts) that can only be exercised by injecting
                                        kernel-level faults. They're covered end-to-end by
                                        SseHandlerTest and LocalApiSocketTest with real
                                        sockets; full line coverage of every defensive catch is
                                        not achievable without fault injection infrastructure.
                                        Tracked separately below with relaxed thresholds.
                                    -->
                                    <excludes>
                                        <exclude>ai.singlr.sail.api.SseHandler</exclude>
                                        <exclude>ai.singlr.sail.api.SseHandler.StreamSubscriber</exclude>
                                        <exclude>ai.singlr.sail.api.LocalApiSocket</exclude>
                                        <exclude>ai.singlr.sail.api.SailOperations</exclude>
                                        <exclude>ai.singlr.sail.api.DispatchOperations</exclude>
                                        <exclude>ai.singlr.sail.api.DispatchOperations.*</exclude>
                                        <exclude>ai.singlr.sail.api.SailApiClient</exclude>
                                        <exclude>ai.singlr.sail.api.ReviewPipelineController</exclude>
                                        <exclude>ai.singlr.sail.api.RunLauncher</exclude>
                                        <exclude>ai.singlr.sail.api.RunLauncher.*</exclude>
                                        <exclude>ai.singlr.sail.api.RunReservation</exclude>
                                        <exclude>ai.singlr.sail.api.InviteLauncher</exclude>
                                        <exclude>ai.singlr.sail.api.AgentLogStreamer</exclude>
                                        <exclude>ai.singlr.sail.api.EventStreamClient</exclude>
                                        <exclude>ai.singlr.sail.api.EventStreamClient.StopReadingException</exclude>
                                    </excludes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>1.0</minimum>
                                        </limit>
                                        <limit>
                                            <counter>METHOD</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>1.0</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>ai.singlr.sail.api.ReviewPipelineController</include>
                                    </includes>
                                    <!--
                                        The review orchestrator: every method is exercised (METHOD
                                        1.0) and the pipeline runs synchronously under a same-thread
                                        executor in tests, so line coverage is deterministic across
                                        runs (no virtual-thread scheduling race). The handful of
                                        uncovered lines are defensive-only — the awaitCompletion
                                        timeout and close-interrupt handlers, the executePipeline
                                        outer catch, and the hostname UnknownHostException fallback —
                                        none reachable without mock-level fault injection. Floored just
                                        under the actual.
                                    -->
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.93</minimum>
                                        </limit>
                                        <limit>
                                            <counter>METHOD</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>1.0</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>ai.singlr.sail.api.RunLauncher</include>
                                    </includes>
                                    <!--
                                        The run launch engine, extracted from the (excluded)
                                        DispatchOperations. Every method is exercised (METHOD 1.0):
                                        the happy path by the four lane suites, the post-launch tail's
                                        defensive branches directly by RunLauncherTest (null status,
                                        cancel-lost-the-launch, foreground completion, status-query
                                        failure, live-run stamping). The uncovered lines are
                                        defensive-only — the exception catches around a throwing
                                        container shell (readStartTicks, launchLostToCancel's halt,
                                        the run-store bookkeeping), the mid-finish recordExitCode race
                                        (a run that goes terminal between the process update and the
                                        foreground completion), and the no-agent watcher branch —
                                        none reachable without fault injection. Floored just under the
                                        actual.
                                    -->
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.88</minimum>
                                        </limit>
                                        <limit>
                                            <counter>METHOD</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>1.0</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>ai.singlr.sail.api.InviteLauncher</include>
                                    </includes>
                                    <!--
                                        The invite lane. Every method is exercised (METHOD 1.0): the
                                        authorize/reserve/complete paths and the defensive guards (no
                                        run store, no agent block, empty room) directly by
                                        InviteLaunchTest. The uncovered lines are defensive-only —
                                        seedRoomDelivery's empty-ledger guard (InvitePrompt always
                                        renders at least the prompt, so a full invite's rendered set
                                        is never empty) and the seed catch (markDelivered would have
                                        to throw between a won reservation and the ledger write) —
                                        neither reachable without fault injection. Floored just under
                                        the actual.
                                    -->
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.93</minimum>
                                        </limit>
                                        <limit>
                                            <counter>METHOD</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>1.0</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>ai.singlr.sail.api.RunReservation</include>
                                    </includes>
                                    <!--
                                        The shared reservation seam. Every method is exercised
                                        (METHOD 1.0): the claim/refusal/release paths and the
                                        best-effort cleanup's defensive branches directly by
                                        RunReservationTest (prune failure, unprobeable agent, no-store
                                        release, store failure during cleanup). The two uncovered
                                        lines are the pruneRuns catch — unreachable because
                                        RunRetention.prune is itself best-effort and swallows the
                                        shell failure rather than propagating it. Floored just under
                                        the actual.
                                    -->
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.95</minimum>
                                        </limit>
                                        <limit>
                                            <counter>METHOD</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>1.0</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>ai.singlr.sail.api.SseHandler</include>
                                        <include>ai.singlr.sail.api.SseHandler.StreamSubscriber</include>
                                        <include>ai.singlr.sail.api.LocalApiSocket</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.7</minimum>
                                        </limit>
                                        <limit>
                                            <counter>METHOD</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.7</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>ai.singlr.sail.api.SailOperations</include>
                                    </includes>
                                    <!--
                                        The central request handler: every method is exercised
                                        (METHOD 1.0) and line coverage sits at ~0.99. The handful of
                                        uncovered lines are a bus-attributed dispatch-event branch
                                        and a best-effort container-setup catch that only fires on an
                                        injected setup failure. Floored just under the actual so the
                                        bar is locked in; raise toward 1.0 as those paths gain
                                        fault-injection coverage.
                                    -->
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.98</minimum>
                                        </limit>
                                        <limit>
                                            <counter>METHOD</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>1.0</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>ai.singlr.sail.api.DispatchOperations</include>
                                    </includes>
                                    <!--
                                        The single dispatch executor shared by the CLI and API
                                        lanes. The uncovered lines are best-effort bookkeeping
                                        catches (run-store warnings, sail-setup refresh failure)
                                        and the terminal launcher's process spawn, none reachable
                                        without fault injection. Floored just under the actual so
                                        the bar is locked in; raise toward 1.0 as those paths gain
                                        coverage.
                                    -->
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                        <limit>
                                            <counter>METHOD</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.95</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>ai.singlr.sail.api.EventStreamClient</include>
                                    </includes>
                                    <!--
                                        EventStreamClient runs a virtual-thread SSE reader that
                                        carries two defensive catch blocks: a generic 'stream
                                        ended' handler (fires when the HTTP body throws while
                                        the watcher main loop is still alive) and a silent
                                        close() that swallows IOException from the underlying
                                        line stream. Both fire only on injected I/O failures
                                        that the testcontainer harness doesn't reproduce. The
                                        happy path, the 4xx response branch, the project filter,
                                        the close() handshake, and the per-line parser are all
                                        exercised by EventStreamClientTest.
                                    -->
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.85</minimum>
                                        </limit>
                                        <limit>
                                            <counter>METHOD</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.85</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>ai.singlr.sail.api.EventStreamClient.StopReadingException</include>
                                    </includes>
                                    <!--
                                        StopReadingException is a private control-flow sentinel
                                        thrown from inside the SSE reader lambda to break out of
                                        Stream.forEach. It carries no logic — just a no-op
                                        constructor — and is never directly tested. Coverage is
                                        deliberately not enforced; the constructor is exercised
                                        only when close() races with the reader.
                                    -->
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.0</minimum>
                                        </limit>
                                        <limit>
                                            <counter>METHOD</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.0</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>ai.singlr.sail.commands.CliCommand</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>1.0</minimum>
                                        </limit>
                                        <limit>
                                            <counter>METHOD</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>1.0</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>1.0</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>ai.singlr.sail.commands.CliJson</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.96</minimum>
                                        </limit>
                                        <limit>
                                            <counter>METHOD</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>1.0</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.97</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>integration</id>
            <properties>
                <sail.it.requireIncus>true</sail.it.requireIncus>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <version>3.5.4</version>
                        <configuration>
                            <argLine>
                                -Duser.timezone=UTC
                                --add-opens java.base/java.util=ALL-UNNAMED
                                --add-opens java.base/java.lang=ALL-UNNAMED
                            </argLine>
                            <systemPropertyVariables>
                                <sail.it.requireIncus>${sail.it.requireIncus}</sail.it.requireIncus>
                            </systemPropertyVariables>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
