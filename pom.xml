<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>ai.singlr</groupId>
    <artifactId>sail</artifactId>
    <version>0.75.0</version>
    <packaging>pom</packaging>

    <modules>
        <module>sail-core</module>
        <module>sail-harness</module>
        <module>sail-infra</module>
        <module>architecture</module>
    </modules>

    <developers>
        <developer>
            <name>Standard Applied Intelligence Labs</name>
            <organization>Standard Applied Intelligence Labs</organization>
            <organizationUrl>https://github.com/standardapplied/sail</organizationUrl>
        </developer>
    </developers>

    <properties>
        <picocli-version>4.7.7</picocli-version>
        <snakeyaml-engine-version>3.1.1</snakeyaml-engine-version>
        <junit-version>6.0.2</junit-version>
        <maven-pmd-plugin-version>3.28.0</maven-pmd-plugin-version>
        <pmd-version>7.28.0</pmd-version>
        <archunit-version>1.5.1</archunit-version>

        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <maven.compiler.release>25</maven.compiler.release>

        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <sail.it.requireIncus>false</sail.it.requireIncus>
        <sail.native.optimization>-O2</sail.native.optimization>
        <sail.quality.config>${maven.multiModuleProjectDirectory}/config/quality</sail.quality.config>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit-version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>info.picocli</groupId>
                <artifactId>picocli</artifactId>
                <version>${picocli-version}</version>
            </dependency>
            <dependency>
                <groupId>org.snakeyaml</groupId>
                <artifactId>snakeyaml-engine</artifactId>
                <version>${snakeyaml-engine-version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <!--
          Every plugin the build runs is versioned here or where it is declared; the enforcer's
          requirePluginVersions fails a build that lets Maven pick one.
        -->
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>3.2.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>3.1.4</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>3.7.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>3.1.4</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-pmd-plugin</artifactId>
                    <version>${maven-pmd-plugin-version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.4.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-site-plugin</artifactId>
                    <version>3.12.1</version>
                </plugin>
                <plugin>
                    <groupId>org.pitest</groupId>
                    <artifactId>pitest-maven</artifactId>
                    <version>1.30.1</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-build-versions</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>25</version>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>3.9.14</version>
                                </requireMavenVersion>
                                <requirePluginVersions/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!--
                  Quality gate, documented in AGENTS.md. `check` and `aggregate-cpd-check` fork
                  their own main-code analysis that reads only this plugin-level configuration, so
                  the main rule set and the shared settings live here; the test-code PMD analysis
                  and the main-and-test CPD analysis are the explicit executions below, each
                  followed by a check pointed at its output directory. Only the checks read the
                  exclusions file, so every report still records what a listed class breaks, which
                  architecture's ExclusionsShrinkTest reads. CPD reports without failing until the
                  pull request that burns its duplications down turns it on.
                -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <dependencies>
                    <dependency>
                        <groupId>net.sourceforge.pmd</groupId>
                        <artifactId>pmd-core</artifactId>
                        <version>${pmd-version}</version>
                    </dependency>
                    <dependency>
                        <groupId>net.sourceforge.pmd</groupId>
                        <artifactId>pmd-java</artifactId>
                        <version>${pmd-version}</version>
                    </dependency>
                    <dependency>
                        <groupId>net.sourceforge.pmd</groupId>
                        <artifactId>pmd-javascript</artifactId>
                        <version>${pmd-version}</version>
                    </dependency>
                    <dependency>
                        <groupId>net.sourceforge.pmd</groupId>
                        <artifactId>pmd-jsp</artifactId>
                        <version>${pmd-version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <rulesets>
                        <ruleset>${sail.quality.config}/pmd-main.xml</ruleset>
                    </rulesets>
                    <targetJdk>${maven.compiler.release}</targetJdk>
                    <skipPmdError>false</skipPmdError>
                    <printFailingErrors>true</printFailingErrors>
                    <analysisCache>true</analysisCache>
                    <linkXRef>false</linkXRef>
                    <minimumTokens>100</minimumTokens>
                </configuration>
                <executions>
                    <execution>
                        <id>pmd-main-check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <excludeFromFailureFile>${sail.quality.config}/pmd-exclusions.properties</excludeFromFailureFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>pmd-test</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>pmd</goal>
                        </goals>
                        <configuration>
                            <includeTests>true</includeTests>
                            <excludeRoots>
                                <excludeRoot>${project.build.sourceDirectory}</excludeRoot>
                            </excludeRoots>
                            <rulesets>
                                <ruleset>${sail.quality.config}/pmd-test.xml</ruleset>
                            </rulesets>
                            <targetDirectory>${project.build.directory}/pmd-test</targetDirectory>
                            <analysisCacheLocation>${project.build.directory}/pmd-test/pmd.cache</analysisCacheLocation>
                        </configuration>
                    </execution>
                    <execution>
                        <id>pmd-test-check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <targetDirectory>${project.build.directory}/pmd-test</targetDirectory>
                            <excludeFromFailureFile>${sail.quality.config}/pmd-exclusions.properties</excludeFromFailureFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>cpd</id>
                        <phase>verify</phase>
                        <inherited>false</inherited>
                        <goals>
                            <goal>aggregate-cpd</goal>
                        </goals>
                        <configuration>
                            <includeTests>true</includeTests>
                            <targetDirectory>${project.build.directory}/cpd</targetDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>cpd-check</id>
                        <inherited>false</inherited>
                        <goals>
                            <goal>aggregate-cpd-check</goal>
                        </goals>
                        <configuration>
                            <targetDirectory>${project.build.directory}/cpd</targetDirectory>
                            <failOnViolation>false</failOnViolation>
                            <printFailingErrors>false</printFailingErrors>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
                <configuration>
                    <!-- one fork per core: each class runs in some fork, so classes share no state -->
                    <forkCount>1C</forkCount>
                    <reuseForks>true</reuseForks>
                    <properties>
                        <configurationParameters>junit.jupiter.execution.parallel.enabled = true</configurationParameters>
                    </properties>
                    <argLine>
                        @{argLine}
                        -Duser.timezone=UTC
                        <!-- the release runs on JDK 25, whose exchanges share their context's attributes -->
                        -Djdk.httpserver.attributes=context
                        --add-opens java.base/java.util=ALL-UNNAMED
                        --add-opens java.base/java.lang=ALL-UNNAMED
                        <!-- a Sail of each fork's own: never the person's, the box's, nor another fork's lock files -->
                        -Duser.home=${project.build.directory}/test-home-${surefire.forkNumber}
                        -Dsail.never-the-system-sail=true
                    </argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>3.2.1</version>
                <configuration>
                    <java>
                        <googleJavaFormat>
                            <version>1.27.0</version>
                            <style>GOOGLE</style>
                        </googleJavaFormat>
                        <importOrder>
                            <order>\#,</order>
                        </importOrder>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <id>spotless-check</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.14</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>ai.singlr.*</include>
                            </includes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>coverage-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <!--
                                        Ratchet: each minimum sits just under the weakest module's
                                        actual for that counter, all currently bound by sail-infra
                                        (~0.65 line / 0.59 branch / 0.79 method / 0.95 class) so the
                                        current bar is locked in and any regression fails the build.
                                        Raise these as coverage climbs toward 100%.
                                    -->
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.64</minimum>
                                        </limit>
                                        <limit>
                                            <counter>METHOD</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.79</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.59</minimum>
                                        </limit>
                                        <limit>
                                            <counter>CLASS</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.95</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>ai.singlr.sail.api.*</include>
                                    </includes>
                                    <!--
                                        Streaming I/O classes carry OS-level error branches
                                        (NIO accept failures, half-closed sockets, slow-client
                                        write timeouts) that can only be exercised by injecting
                                        kernel-level faults. They're covered end-to-end by
                                        SseHandlerTest and LocalApiSocketTest with real
                                        sockets; full line coverage of every defensive catch is
                                        not achievable without fault injection infrastructure.
                                        Tracked separately below with relaxed thresholds.
                                    -->
                                    <excludes>
                                        <exclude>ai.singlr.sail.api.SseHandler</exclude>
                                        <exclude>ai.singlr.sail.api.SseHandler.StreamSubscriber</exclude>
                                        <exclude>ai.singlr.sail.api.LocalApiSocket</exclude>
                                        <exclude>ai.singlr.sail.api.SailOperations</exclude>
                                        <exclude>ai.singlr.sail.api.DispatchOperations</exclude>
                                        <exclude>ai.singlr.sail.api.DispatchOperations.*</exclude>
                                        <exclude>ai.singlr.sail.api.SailApiClient</exclude>
                                        <exclude>ai.singlr.sail.api.RunLauncher</exclude>
                                        <exclude>ai.singlr.sail.api.RunLauncher.*</exclude>
                                        <exclude>ai.singlr.sail.api.RunReservation</exclude>
                                        <exclude>ai.singlr.sail.api.InviteLauncher</exclude>
                                        <exclude>ai.singlr.sail.api.AgentLogStreamer</exclude>
                                        <exclude>ai.singlr.sail.api.EventStreamClient</exclude>
                                        <exclude>ai.singlr.sail.api.EventStreamClient.StopReadingException</exclude>
                                    </excludes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>1.0</minimum>
                                        </limit>
                                        <limit>
                                            <counter>METHOD</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>1.0</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>ai.singlr.sail.access.*</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>1.0</minimum>
                                        </limit>
                                        <limit>
                                            <counter>METHOD</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>1.0</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>1.0</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>ai.singlr.sail.api.RunLauncher</include>
                                    </includes>
                                    <!--
                                        The run launch engine, extracted from the (excluded)
                                        DispatchOperations. Every method is exercised (METHOD 1.0):
                                        the happy path by the four lane suites, the post-launch tail's
                                        defensive branches directly by RunLauncherTest (null status,
                                        cancel-lost-the-launch, foreground completion, status-query
                                        failure, live-run stamping). The uncovered lines are
                                        defensive-only — the exception catches around a throwing
                                        container shell (readStartTicks, launchLostToCancel's halt,
                                        the run-store bookkeeping), the mid-finish recordExitCode race
                                        (a run that goes terminal between the process update and the
                                        foreground completion), and the no-agent watcher branch —
                                        none reachable without fault injection. Floored just under the
                                        actual.
                                    -->
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.88</minimum>
                                        </limit>
                                        <limit>
                                            <counter>METHOD</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>1.0</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>ai.singlr.sail.api.InviteLauncher</include>
                                    </includes>
                                    <!--
                                        The invite lane. Every method is exercised (METHOD 1.0): the
                                        authorize/reserve/complete paths and the defensive guards (no
                                        run store, no agent block, empty room) directly by
                                        InviteLaunchTest. The uncovered lines are defensive-only —
                                        seedRoomDelivery's empty-ledger guard (InvitePrompt always
                                        renders at least the prompt, so a full invite's rendered set
                                        is never empty) and the seed catch (markDelivered would have
                                        to throw between a won reservation and the ledger write) —
                                        neither reachable without fault injection. Floored just under
                                        the actual.
                                    -->
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.93</minimum>
                                        </limit>
                                        <limit>
                                            <counter>METHOD</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>1.0</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>ai.singlr.sail.api.RunReservation</include>
                                    </includes>
                                    <!--
                                        The shared reservation seam. Every method is exercised
                                        (METHOD 1.0): the claim/refusal/release paths and the
                                        best-effort cleanup's defensive branches directly by
                                        RunReservationTest (prune failure, unprobeable agent, no-store
                                        release, store failure during cleanup). The two uncovered
                                        lines are the pruneRuns catch — unreachable because
                                        RunRetention.prune is itself best-effort and swallows the
                                        shell failure rather than propagating it. Floored just under
                                        the actual.
                                    -->
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.95</minimum>
                                        </limit>
                                        <limit>
                                            <counter>METHOD</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>1.0</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>ai.singlr.sail.api.SseHandler</include>
                                        <include>ai.singlr.sail.api.SseHandler.StreamSubscriber</include>
                                        <include>ai.singlr.sail.api.LocalApiSocket</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.7</minimum>
                                        </limit>
                                        <limit>
                                            <counter>METHOD</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.7</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>ai.singlr.sail.api.SailOperations</include>
                                    </includes>
                                    <!--
                                        The central request handler: every method is exercised
                                        (METHOD 1.0) and line coverage sits at ~0.99. The handful of
                                        uncovered lines are a bus-attributed dispatch-event branch
                                        and a best-effort container-setup catch that only fires on an
                                        injected setup failure. Floored just under the actual so the
                                        bar is locked in; raise toward 1.0 as those paths gain
                                        fault-injection coverage.
                                    -->
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.98</minimum>
                                        </limit>
                                        <limit>
                                            <counter>METHOD</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>1.0</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>ai.singlr.sail.api.DispatchOperations</include>
                                    </includes>
                                    <!--
                                        The single dispatch executor shared by the CLI and API
                                        lanes. The uncovered lines are best-effort bookkeeping
                                        catches (run-store warnings, sail-setup refresh failure)
                                        and the terminal launcher's process spawn, none reachable
                                        without fault injection. Floored just under the actual so
                                        the bar is locked in; raise toward 1.0 as those paths gain
                                        coverage.
                                    -->
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                        <limit>
                                            <counter>METHOD</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.95</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>ai.singlr.sail.api.EventStreamClient</include>
                                    </includes>
                                    <!--
                                        EventStreamClient runs a virtual-thread SSE reader that
                                        carries two defensive catch blocks: a generic 'stream
                                        ended' handler (fires when the HTTP body throws while
                                        the watcher main loop is still alive) and a silent
                                        close() that swallows IOException from the underlying
                                        line stream. Both fire only on injected I/O failures
                                        that the testcontainer harness doesn't reproduce. The
                                        happy path, the 4xx response branch, the project filter,
                                        the close() handshake, and the per-line parser are all
                                        exercised by EventStreamClientTest.
                                    -->
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.85</minimum>
                                        </limit>
                                        <limit>
                                            <counter>METHOD</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.85</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>ai.singlr.sail.api.EventStreamClient.StopReadingException</include>
                                    </includes>
                                    <!--
                                        StopReadingException is a private control-flow sentinel
                                        thrown from inside the SSE reader lambda to break out of
                                        Stream.forEach. It carries no logic — just a no-op
                                        constructor — and is never directly tested. Coverage is
                                        deliberately not enforced; the constructor is exercised
                                        only when close() races with the reader.
                                    -->
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.0</minimum>
                                        </limit>
                                        <limit>
                                            <counter>METHOD</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.0</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>ai.singlr.sail.commands.CliCommand</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>1.0</minimum>
                                        </limit>
                                        <limit>
                                            <counter>METHOD</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>1.0</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>1.0</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>ai.singlr.sail.commands.CliJson</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.96</minimum>
                                        </limit>
                                        <limit>
                                            <counter>METHOD</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>1.0</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.97</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>integration</id>
            <properties>
                <sail.it.requireIncus>true</sail.it.requireIncus>
                <sail.it.requireSystemd>true</sail.it.requireSystemd>
                <sail.it.requireNative>false</sail.it.requireNative>
                <sail.it.nativeBinary/>
                <sail.it.releasedBinary/>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <version>3.5.4</version>
                        <configuration>
                            <argLine>
                                -Duser.timezone=UTC
                                --add-opens java.base/java.util=ALL-UNNAMED
                                --add-opens java.base/java.lang=ALL-UNNAMED
                                <!-- a Sail of each fork's own, as the unit tests have -->
                                -Duser.home=${project.build.directory}/it-home-${surefire.forkNumber}
                                -Dsail.never-the-system-sail=true
                            </argLine>
                            <systemPropertyVariables>
                                <sail.it.requireIncus>${sail.it.requireIncus}</sail.it.requireIncus>
                                <sail.it.requireSystemd>${sail.it.requireSystemd}</sail.it.requireSystemd>
                                <sail.it.requireNative>${sail.it.requireNative}</sail.it.requireNative>
                                <sail.it.nativeBinary>${sail.it.nativeBinary}</sail.it.nativeBinary>
                                <sail.it.releasedBinary>${sail.it.releasedBinary}</sail.it.releasedBinary>
                            </systemPropertyVariables>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>mutation</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>1.2.3</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <threads>4</threads>
                            <timestampedReports>false</timestampedReports>
                            <outputFormats>
                                <outputFormat>HTML</outputFormat>
                                <outputFormat>XML</outputFormat>
                            </outputFormats>
                            <mutators>
                                <mutator>DEFAULTS</mutator>
                            </mutators>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
