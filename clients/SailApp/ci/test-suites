#!/usr/bin/env bash
# Runs every test suite the package lists (swift test list), each in its own process bounded at
# 240 s, since a test stuck in a synchronous wait cannot be stopped by its own time limit; on macOS
# through a pty, so its lines are not buffered away. Fails when the package lists no suite or a
# test outside any suite (which this would not run), when a suite fails, and when a listed suite
# passed no test of its own (every test disabled is none), and when a suite or a test started and
# never ended, read from the test library's own event stream (../SailKit/scripts/ends; the console
# drops end lines on macOS). A suite that ends without a result is
# said by how its process ended (its exit status, or the signal that ended it), with any crash
# report macOS wrote during its run: the crashing thread printed, the report kept beside the logs.
# On macOS a suite its alarm ended may leave its test process running (the alarm ends `script`
# alone): every thread of it is sampled into the logs and it is ended. Then the window server is
# asked whether it answers a new process (ci/window-server); when it does not, no later suite runs,
# as each would only wait on it until its own alarm, and this fails at once saying so.
set -uo pipefail

[[ $# -eq 1 ]] || { echo "usage: ci/test-suites LOGDIR" >&2; exit 2; }
readonly logs=$1
mkdir -p "$logs"
"$(dirname "$0")/window-server-check" || exit 1
: > "$logs/window-server.since"

# Ended by a pattern, not by walking the suite's tree: once the alarm ends `script`, its children
# are launchd's, in the session `script` gave them, so no tree or group reaches them. The pattern
# is this checkout's own `.build` path (its characters escaped), which no other process runs from.
outlived() {
  local suite=$1 build pids pid
  # shellcheck disable=SC2001
  build=$(sed 's/[][\.*^$+?(){}|]/\\&/g' <<< "$PWD/.build/")
  pids=$(pgrep -f -- "$build.*PackageTests" || true)
  for pid in $pids; do
    perl -e 'alarm shift; exec @ARGV or exit 127' 30 sample "$pid" 3 -file "$logs/$suite.outlived-$pid.txt" > /dev/null 2>&1 || true
    echo "ci/test-suites: $suite's test process $pid outlived its alarm; its threads are in $logs/$suite.outlived-$pid.txt, and it is ended" >&2
    kill -KILL "$pid" 2> /dev/null || true
  done
}

tests=$(swift test list --skip-build)
listed=$(sed -nE 's#^([A-Za-z0-9_]+\.[A-Za-z0-9_]+)/.*#\1#p' <<< "$tests" | sort -u)
[[ -n $listed ]] || { echo "ci/test-suites: the package lists no test suite" >&2; exit 1; }

failed=0
ran=()
if outside=$(grep -Ev '^[A-Za-z0-9_]+\.[A-Za-z0-9_]+/' <<< "$tests" | grep .); then
  echo "ci/test-suites: these tests are in no suite, so no run here would run them; put each in a @Suite: $(tr '\n' ' ' <<< "$outside")" >&2
  failed=1
fi
for suite in $listed; do
  echo "::group::$suite"
  log=$logs/$suite.log
  filter="^${suite//./\\.}/"
  : > "$logs/$suite.started"
  rm -f "$logs/$suite.events"
  events=(--event-stream-output-path "$logs/$suite.events" --event-stream-version 0)
  status=0
  if [[ $(uname) == Darwin ]]; then
    perl -e 'alarm shift; exec @ARGV' 240 script -q "$log" swift test --skip-build --filter "$filter" "${events[@]}" || status=$?
  else
    perl -e 'alarm shift; exec @ARGV' 240 swift test --skip-build --filter "$filter" "${events[@]}" > "$log" 2>&1 || status=$?
    cat "$log"
  fi
  echo "$status" > "$logs/$suite.status"
  ran+=("$suite")
  (( status == 0 )) || failed=1
  echo "::endgroup::"
  if (( status == 142 )) && [[ $(uname) == Darwin ]]; then
    outlived "$suite"
    "$(dirname "$0")/window-server" "$logs"
    if (( $? == 1 )); then
      echo "ci/test-suites: no suite after $suite runs: each would wait on the window server until its own alarm" >&2
      break
    fi
  fi
done

suites=("${ran[@]}")
for index in "${!suites[@]}"; do
  suite=${suites[$index]} next=${suites[$((index + 1))]:-}
  log=$logs/$suite.log
  if ! grep -E 'Test [A-Za-z_][^ ]*\(' "$log" 2> /dev/null | grep -q 'passed after' || ! grep -Eq 'Test run with [1-9][0-9]* tests? in .* passed' "$log"; then
    status=$(cat "$logs/$suite.status")
    if (( status == 142 )); then ended="was ended by its 240 s alarm (signal 14)"
    elif (( status > 128 )); then ended="was ended by signal $((status - 128))"
    else ended="exited with $status"; fi
    echo "ci/test-suites: $suite did not pass a run of at least one test: its run $ended" >&2
    if [[ $(uname) == Darwin ]]; then
      # A report is written seconds after its crash, so the window runs to the next suite's start.
      reports=$(find "$HOME/Library/Logs/DiagnosticReports" -name '*.ips' -newer "$logs/$suite.started" ${next:+! -newer "$logs/$next.started"} 2> /dev/null || true)
      if [[ -n $reports ]]; then
        for report in $reports; do cp "$report" "$logs/"; done
        "$(dirname "$0")/crash-frames" $reports | sed 's/^/ci\/test-suites: /' >&2
      else
        echo "ci/test-suites: macOS wrote no crash report from $suite's start to the next suite's" >&2
      fi
    fi
    failed=1
  fi
done
"$(dirname "$0")/../../SailKit/scripts/ends" "$logs"/*.events || failed=1
unrun=$(comm -23 <(sort <<< "$listed") <(printf '%s\n' "${ran[@]}" | sort) | paste -sd ' ' -)
echo "ci/test-suites: ${#ran[@]} of $(wc -w <<< "$listed" | tr -d ' ') suites ran: ${ran[*]}${unrun:+; not run: $unrun}"
exit $failed
