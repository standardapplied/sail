#!/usr/bin/env bash
# Runs the drive build against this Mac's own host and two control planes the bundled sail starts
# here, each on a data directory of its own: one taking passkeys for sail.standardapplied.com on
# 7979, with uday an admin and a ticket to enroll him, and one with no relying party on 7980.
# Every run but the second starts with none of the app's settings.
# Tests/Drive/first.json runs, then the app is quit and opened again for Tests/Drive/second.json,
# which keeps what the first left. Then another copy of Sail's host runs from another bundle's
# path, with a client attached to one of its sessions, and the app is opened once more for
# Tests/Drive/third.json; then, with no host, once more for Tests/Drive/shots.json: the window as
# the screen shows it; then the same way once more for Tests/Drive/workspaces.json, every
# control-plane call answered from the goldens;
# then, with keyboard navigation on, for Tests/Drive/kit.json, the controls' gallery, left to right
# and once more right to left (kit-rtl).
# Each run's texts, images and report land in OUT; what it prints, and the servers' logs, beside
# them. Every run is opened by LaunchServices (`open -W -n -a`), as a person's Sail is: exec'd from
# this shell, the app had no application role, every thread was held at the utility priority (20)
# and its timers were coalesced, so the drive measured an app no person runs. The ticket is handed
# to the drive in a file only it reads, never in the environment a launch passes on, and printed
# nowhere.
set -euo pipefail

[[ $# -eq 2 ]] || { echo "usage: ci/drive DRIVE_APP OUT" >&2; exit 2; }
readonly app=$1 out=$2
codesign --verify --deep --strict "$app" \
  || { echo "ci/drive: $app is not soundly signed (codesign --verify --deep --strict failed above); the drive runs no half-signed app" >&2; exit 1; }
cd "$(dirname "$0")/.."
readonly drive=$app/Contents/MacOS/SailDrive sail=$app/Contents/Helpers/sail
[[ -x $drive ]] || { echo "ci/drive: $app holds no SailDrive" >&2; exit 1; }

mkdir -p "$out"
readonly out_dir=$(cd "$out" && pwd -P) scripts=$PWD/Tests/Drive
passkeys=$(mktemp -d) plain=$(mktemp -d) private_dir=$(mktemp -d /tmp/sail-drive.XXXXXX) shooter=
SAIL_DATA_DIR=$passkeys "$sail" server start --port 7979 --rp-id sail.standardapplied.com --origin https://sail.standardapplied.com \
  > "$out/server-7979.log" 2>&1 &
servers=($!)
SAIL_DATA_DIR=$plain "$sail" server start --port 7980 > "$out/server-7980.log" 2>&1 &
servers+=($!)
# The kit runs turn Keyboard Navigation on (a setting of the whole Mac) and it is put back as it was
# when this ends; outside CI they change it only when SAIL_DRIVE_KEYBOARD_NAVIGATION=on says so.
keyboard_was=$(defaults read -g AppleKeyboardUIMode 2> /dev/null || echo unset) keyboard_changed=0
restore_keyboard() {
  (( keyboard_changed )) || return 0
  if [[ $keyboard_was == unset ]]; then defaults delete -g AppleKeyboardUIMode 2> /dev/null || true
  else defaults write -g AppleKeyboardUIMode -int "$keyboard_was"; fi
}
# A drive LaunchServices opened is launchd's child, not this shell's: ended here, on a timeout and on
# every exit (a local cancel too), with TERM, then KILL if it has not gone within 10 s. Only drives
# writing into this OUT are ended, not another ci/drive's.
readonly opened_pattern="SailDrive --drive .* --out $out_dir/"
stop_drive() {
  local pids
  pids=$(pgrep -f -- "$opened_pattern" || true)
  [[ -n $pids ]] || return 0
  echo "ci/drive: ending the drive still running (pid $pids)" >&2
  kill -TERM $pids 2> /dev/null || true
  perl -e 'alarm shift; exec @ARGV' 10 bash -c 'while pgrep -f -- "$1" > /dev/null; do sleep 0.1; done' _ "$opened_pattern" || true
  pids=$(pgrep -f -- "$opened_pattern" || true)
  [[ -z $pids ]] || kill -KILL $pids 2> /dev/null || true
}
trap 'stop_drive; declare -F stop_shots > /dev/null && stop_shots; kill "${servers[@]}" 2>/dev/null || true; rm -rf "$passkeys" "$plain" "$private_dir"; restore_keyboard' EXIT
for port in 7979 7980; do
  for _ in $(seq 1 60); do
    curl -fsS "http://127.0.0.1:$port/v1/health" > /dev/null 2>&1 && break
    sleep 1
  done
  curl -fsS "http://127.0.0.1:$port/v1/health" > /dev/null || {
    echo "ci/drive: the control plane on $port did not answer within 60 s:" >&2
    tail -20 "$out/server-$port.log" >&2
    exit 1
  }
done

export SAIL_DATA_DIR=$passkeys
"$sail" fde add uday --name Uday --role admin
(umask 077 && "$sail" fde enroll uday --json | plutil -extract ticket raw - > "$private_dir/ticket")
export SAIL_DRIVE_TICKET_FILE=$private_dir/ticket SAIL_DRIVE_PASSKEY=$out_dir/software-passkey.json
rm -f "$SAIL_DRIVE_PASSKEY"

# Opened by LaunchServices, the app is its own responsible process for the privacy grants and holds
# no Screen Recording; this shell does, so it takes the drive's screenshots. A request is one line on
# the FIFO SAIL_DRIVE_SHOTS names: `screen FILE`, `window ID FILE` or `menu FILE`, tab-separated;
# this shell builds screencapture's arguments itself, ID all digits and FILE in OUT (its folder
# with links resolved, and itself no link), and answers with FILE.done beside FILE.said, what
# screencapture said. Nothing else is taken. Any process of this user may ask while a run lasts,
# so this shell's Screen Recording is lent to them for captures into OUT: fine on a CI runner,
# worth knowing on a Mac of one's own.
inside_out() {
  local file=$1 folder
  [[ $file == /* && ! -L $file ]] || return 1
  folder=$(cd "$(dirname "$file")" 2> /dev/null && pwd -P) || return 1
  [[ $folder == "$out_dir" || $folder == "$out_dir"/* ]]
}
# The FIFO is held open for reading and writing, so the taker never blocks reopening it between
# requests; ended (TERM), it exits quietly, and stop_shots reaps it.
take_shots() {
  local verb id file extra arguments
  trap 'exit 0' TERM
  exec 3<> "$SAIL_DRIVE_SHOTS"
  while IFS=$'\t' read -r -u 3 verb id file extra; do
    case $verb in
      screen | menu)
        [[ -z $file ]] || verb=refused
        file=$id
        ;;
      window) [[ $id =~ ^[0-9]+$ && -z $extra ]] || verb=refused ;;
      *) verb=refused ;;
    esac
    if [[ $verb == refused ]] || ! inside_out "$file"; then
      echo "ci/drive: a screenshot request refused" >&2
      continue
    fi
    case $verb in
      screen) arguments=(-x) ;;
      menu) arguments=(-x -T 1) ;;
      window) arguments=(-x -o -l "$id") ;;
    esac
    screencapture "${arguments[@]}" "$file" 2> "$file.said" || true
    : > "$file.done"
  done
}
stop_shots() {
  [[ -n $shooter ]] || return 0
  kill "$shooter" 2> /dev/null || true
  wait "$shooter" 2> /dev/null || true
}
export SAIL_DRIVE_SHOTS=$private_dir/shots
mkfifo -m 600 "$SAIL_DRIVE_SHOTS"
take_shots &
shooter=$!

# Opens the drive build as LaunchServices opens a person's app, waits for it to quit and prints what
# it printed. `open` tells nothing of the app's exit status, so a run passes only when all of these
# hold, and returns: 0 passed; 1 a step failed; 124 the alarm ended `open` (a hang, the drive then
# ended); 134 a crash or a hang at quit (no mark of a clean exit, or a new SailDrive crash report),
# or no report. Its folder and output are removed first, so an earlier run's report never passes.
# SAIL_DRIVE_ALARM_SECONDS (600) bounds it; ci/drive's own check of these sets it short.
open_drive() {
  local run=$1 goldens=$2 opened=0 crashes
  shift 2
  rm -rf "${out_dir:?}/$run"
  : > "$out_dir/$run-output.txt"
  : > "$out_dir/$run-errors.txt"
  : > "$private_dir/$run-started"
  perl -e 'alarm shift; exec @ARGV' "${SAIL_DRIVE_ALARM_SECONDS:-600}" open -W -n -a "$app" --stdout "$out_dir/$run-output.txt" \
    --stderr "$out_dir/$run-errors.txt" --env "SAIL_DRIVE_GOLDENS=$goldens" --args "$@" || opened=$?
  cat "$out_dir/$run-output.txt"
  cat "$out_dir/$run-errors.txt" >&2
  if ((opened != 0)); then
    echo "ci/drive: the $run run did not end within ${SAIL_DRIVE_ALARM_SECONDS:-600} s (open ended with status $opened)" >&2
    stop_drive
    return 124
  fi
  crashes=$(find "$HOME/Library/Logs/DiagnosticReports" -name 'SailDrive*.ips' -newer "$private_dir/$run-started" 2> /dev/null || true)
  if [[ -n $crashes ]]; then
    echo "ci/drive: the $run run left a crash report: $crashes" >&2
    return 134
  fi
  if [[ ! -e $out_dir/$run/exited ]]; then
    echo "ci/drive: the $run run did not exit cleanly: it crashed or hung as it quit, or never started" >&2
    return 134
  fi
  case $(plutil -extract passed raw "$out_dir/$run/report.json" 2> /dev/null || echo none) in
    true) return 0 ;;
    false) return 1 ;;
    *)
      echo "ci/drive: the $run run left no report" >&2
      return 134
      ;;
  esac
}

for run in first second third shots workspaces kit kit-rtl; do
  if [[ $run == third ]]; then
    echo "ci/drive: another copy's host, and a client on it"
    pkill -f '_pty-host --local' || true
    perl -e 'alarm shift; exec @ARGV' 30 bash -c 'while pgrep -f "_pty-host --local" > /dev/null; do :; done'
    other=$out/other-build/Sail.app/Contents/Helpers
    socket=$HOME/.sail/local/pty.sock
    mkdir -p "$other" && cp "$sail" "$other/sail"
    ("$other/sail" _pty-host --local > "$out/other-host.log" 2>&1 &)
    perl -e 'alarm shift; exec @ARGV' 30 bash -c 'until "$1" session ls --socket "$2" > /dev/null 2>&1; do :; done' _ "$other/sail" "$socket"
    "$other/sail" session new held --socket "$socket" --command cat > /dev/null
    (tail -f /dev/null | script -q /dev/null "$other/sail" session attach held --socket "$socket" > /dev/null 2>&1 &)
    perl -e 'alarm shift; exec @ARGV' 30 bash -c 'until "$1" session ls --socket "$2" --json | grep -Eq "\"attached\" *: *1"; do :; done' _ "$other/sail" "$socket"
  fi
  if [[ $run == shots || $run == workspaces ]]; then
    echo "ci/drive: a fresh start for the $run: no host"
    pkill -f '_pty-host --local' || true
    perl -e 'alarm shift; exec @ARGV' 30 bash -c 'while pgrep -f "_pty-host --local" > /dev/null; do :; done'
  fi
  if [[ $run != second ]]; then
    echo "ci/drive: none of the app's settings for the $run"
    defaults delete "$(plutil -extract CFBundleIdentifier raw "$app/Contents/Info.plist")" 2> /dev/null || true
  fi
  echo "ci/drive: $run"
  goldens=off
  [[ $run == workspaces ]] && goldens=on
  script=$run directions=()
  if [[ $run == kit* ]]; then
    if [[ ${CI:-} != true && ${SAIL_DRIVE_KEYBOARD_NAVIGATION:-} != on ]]; then
      echo "ci/drive: $run skipped: it turns on Keyboard Navigation, a setting of this whole Mac; SAIL_DRIVE_KEYBOARD_NAVIGATION=on lets it, and it is put back after"
      continue
    fi
    script=kit keyboard_changed=1
    defaults write -g AppleKeyboardUIMode -int 2
  fi
  [[ $run == kit-rtl ]] && directions=(-AppleTextDirection YES -NSForceRightToLeftWritingDirection YES)
  status=0
  open_drive "$run" "$goldens" --drive "$scripts/$script.json" --out "$out_dir/$run" ${directions[@]+"${directions[@]}"} || status=$?
  (( status == 0 )) || {
    echo "ci/drive: the sessions this Mac's host holds now:"
    "$sail" session ls --socket "$HOME/.sail/local/pty.sock" --json 2>&1 || true
    echo "ci/drive: the arrangement the app saved; a live This Mac session it does not hold is the next launch's extra tab:"
    defaults export "$(plutil -extract CFBundleIdentifier raw "$app/Contents/Info.plist")" - 2> /dev/null \
      | python3 -c 'import plistlib, sys; print(plistlib.loads(sys.stdin.buffer.read()).get("workbench.arrangement", b"none saved").decode())' 2>&1 || true
    reports=$HOME/Library/Logs/DiagnosticReports
    # The drive left no report (it crashed): ReportCrash writes its report some seconds later. Any
    # other failure is a step's, with no crash report to wait for.
    if (( status > 128 )); then
      perl -e 'alarm shift; exec @ARGV' 90 bash -c 'until compgen -G "$1/SailDrive*.ips" > /dev/null; do sleep 1; done' _ "$reports" || true
    fi
    if compgen -G "$reports/SailDrive*.ips" > /dev/null; then
      cp "$reports"/SailDrive*.ips "$out/"
      for report in "$reports"/SailDrive*.ips; do
        python3 - "$report" <<'PY'
import json, sys
text = open(sys.argv[1]).read()
body = json.loads(text[text.index("\n") + 1:])
images = body.get("usedImages", [])
print("ci/drive: crash report", sys.argv[1], body.get("exception"), body.get("termination", {}).get("indicator"))
for index, thread in enumerate(body.get("threads", [])):
    if index != body.get("faultingThread") and not thread.get("triggered"):
        continue
    print("faulting thread", index, thread.get("name", ""), thread.get("queue", ""))
    for frame in thread.get("frames", [])[:60]:
        image = images[frame["imageIndex"]].get("name", "?") if frame.get("imageIndex", -1) < len(images) else "?"
        print("  ", image, frame.get("symbol", hex(frame.get("imageOffset", 0))), frame.get("symbolLocation", ""))
PY
      done
    elif (( status > 128 )); then
      echo "ci/drive: the drive left no crash report in $reports within 90 s" >&2
    fi
    exit "$status"
  }
done
# The third script measures nothing: its sampler never runs, and its last line says so rather
# than judging the CPU share of a watcher that had no period to run in.
grep -qF "the main thread's sampler never ran: no step measured a wait" "$out/third-output.txt" \
  || { echo "ci/drive: the third script measured nothing, yet its last line did not say its sampler never ran" >&2; exit 1; }
