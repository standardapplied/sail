#!/usr/bin/env bash
# Signs APP with the hardened runtime: the bundled sail first, with no entitlements, then the app.
# When ci/signing says signing is on: with the Developer ID from a keychain made for this run and
# deleted when it ends; the Developer ID provisioning profile embedded as
# Contents/embedded.provisionprofile; and the app, never the inner sail, claiming ci/Sail.entitlements
# with the team id the profile names, once the profile is shown to be for the app's own App ID. When
# off, ad hoc with no profile and no entitlements, an unsigned build: a restricted entitlement with
# no profile to authorize it would stop the app from launching, so the hardened runtime still applies
# to everything the lane runs. Nothing it prints names the team or holds the profile.
set -euo pipefail

[[ $# -eq 1 ]] || { echo "usage: ci/sign APP" >&2; exit 2; }
readonly app=$1 here=$(dirname "$0")
[[ -d $app/Contents/Helpers ]] || { echo "ci/sign: $app is not a bundle ci/bundle made" >&2; exit 1; }

identity=-
timestamp=--timestamp=none
keychain=()
entitlements=()
mode=$("$here/signing")
if [[ $mode == on ]]; then
  readonly temp=${RUNNER_TEMP:?ci/sign: RUNNER_TEMP is not set}
  readonly chain=$temp/sail-signing.keychain-db profile=$app/Contents/embedded.provisionprofile
  password=$(uuidgen)
  trap 'rm -f "$temp/signing.p12" "$temp/profile.plist" "$temp/Sail.entitlements"; security delete-keychain "$chain" 2>/dev/null || true' EXIT
  security create-keychain -p "$password" "$chain"
  security set-keychain-settings -lut 1800 "$chain"
  security unlock-keychain -p "$password" "$chain"
  (
    umask 077
    printf '%s' "$APPLE_CERTIFICATE" | base64 --decode > "$temp/signing.p12"
  )
  security import "$temp/signing.p12" -k "$chain" -P "$APPLE_CERTIFICATE_PASSWORD" -T /usr/bin/codesign >/dev/null
  rm -f "$temp/signing.p12"
  security set-key-partition-list -S apple-tool:,apple: -s -k "$password" "$chain" >/dev/null
  security list-keychains -d user -s "$chain" $(security list-keychains -d user | tr -d '"')
  identity=$APPLE_SIGNING_IDENTITY
  timestamp=--timestamp
  keychain=(--keychain "$chain")

  printf '%s' "$APPLE_PROVISIONING_PROFILE_BASE64" | base64 --decode > "$profile"
  chmod 644 "$profile"
  security cms -D -i "$profile" -o "$temp/profile.plist" 2>/dev/null \
    || { echo "ci/sign: APPLE_PROVISIONING_PROFILE_BASE64 does not hold a signed provisioning profile" >&2; exit 1; }
  team=$(/usr/libexec/PlistBuddy -c 'Print :TeamIdentifier:0' "$temp/profile.plist")
  appid=$(/usr/libexec/PlistBuddy -c 'Print :Entitlements:com.apple.application-identifier' "$temp/profile.plist" 2>/dev/null || true)
  identifier=$(plutil -extract CFBundleIdentifier raw "$app/Contents/Info.plist")
  [[ $appid == "$team.$identifier" ]] \
    || { echo "ci/sign: the provisioning profile is not for the App ID of $identifier; make a Developer ID profile for it" >&2; exit 1; }
  sed -e "s/@TEAM@/$team/g" -e "s/@IDENTIFIER@/$identifier/g" "$here/Sail.entitlements" > "$temp/Sail.entitlements"
  entitlements=(--entitlements "$temp/Sail.entitlements")
fi

# Signs FILE with codesign and the arguments after it. Apple's timestamp service not answering is
# the one failure tried again: codesign then exits non-zero saying "A timestamp was expected but was
# not found", the Security framework's sentence for errSecCSTimestampMissing (a signature that asked
# for a secure timestamp got none), which no other codesign failure says. Up to five attempts 15 s
# apart, each said; any other failure fails at once.
sign() {
  local file=$1 attempt output
  shift
  for attempt in 1 2 3 4 5; do
    if output=$(codesign "$@" "$file" 2>&1); then
      [[ -z $output ]] || printf '%s\n' "$output"
      return 0
    fi
    printf '%s\n' "$output" >&2
    grep -qF 'A timestamp was expected but was not found' <<< "$output" || return 1
    if [[ $attempt -lt 5 ]]; then
      echo "ci/sign: Apple's timestamp service gave $file no timestamp (attempt $attempt of 5); signing it again in 15 s" >&2
      sleep 15
    fi
  done
  echo "ci/sign: Apple's timestamp service gave $file no timestamp in 5 attempts; $app is not signed" >&2
  return 1
}

sign "$app/Contents/Helpers/sail" --force --options runtime "$timestamp" ${keychain[@]+"${keychain[@]}"} --sign "$identity"
sign "$app" --force --options runtime "$timestamp" ${keychain[@]+"${keychain[@]}"} ${entitlements[@]+"${entitlements[@]}"} --sign "$identity"
codesign --verify --deep --strict "$app"
echo "ci/sign: $app signed $([[ $identity == - ]] && echo "ad hoc: an unsigned build" || echo "with Developer ID, its profile and entitlements")"
