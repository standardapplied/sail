#!/usr/bin/env bash
# Signs APP with the hardened runtime: the bundled sail first, then the app. When ci/signing says
# signing is on, with the Developer ID from a keychain made for this run and deleted when it ends,
# with the certificate file; when off, ad hoc, an unsigned build, so the hardened runtime still
# applies to everything the lane runs.
set -euo pipefail

[[ $# -eq 1 ]] || { echo "usage: ci/sign APP" >&2; exit 2; }
readonly app=$1
[[ -d $app/Contents/Helpers ]] || { echo "ci/sign: $app is not a bundle ci/bundle made" >&2; exit 1; }

identity=-
timestamp=--timestamp=none
keychain=()
mode=$("$(dirname "$0")/signing")
if [[ $mode == on ]]; then
  readonly temp=${RUNNER_TEMP:?ci/sign: RUNNER_TEMP is not set}
  readonly chain=$temp/sail-signing.keychain-db
  password=$(uuidgen)
  trap 'rm -f "$temp/signing.p12"; security delete-keychain "$chain" 2>/dev/null || true' EXIT
  security create-keychain -p "$password" "$chain"
  security set-keychain-settings -lut 1800 "$chain"
  security unlock-keychain -p "$password" "$chain"
  (
    umask 077
    printf '%s' "$APPLE_CERTIFICATE" | base64 --decode > "$temp/signing.p12"
  )
  security import "$temp/signing.p12" -k "$chain" -P "$APPLE_CERTIFICATE_PASSWORD" -T /usr/bin/codesign >/dev/null
  rm -f "$temp/signing.p12"
  security set-key-partition-list -S apple-tool:,apple: -s -k "$password" "$chain" >/dev/null
  security list-keychains -d user -s "$chain" $(security list-keychains -d user | tr -d '"')
  identity=$APPLE_SIGNING_IDENTITY
  timestamp=--timestamp
  keychain=(--keychain "$chain")
fi

codesign --force --options runtime "$timestamp" ${keychain[@]+"${keychain[@]}"} --sign "$identity" "$app/Contents/Helpers/sail"
codesign --force --options runtime "$timestamp" ${keychain[@]+"${keychain[@]}"} --sign "$identity" "$app"
codesign --verify --deep --strict "$app"
echo "ci/sign: $app signed $([[ $identity == - ]] && echo "ad hoc: an unsigned build" || echo "with Developer ID")"
