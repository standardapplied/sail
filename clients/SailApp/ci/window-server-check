#!/usr/bin/env bash
# Proves ci/window-server on stand-ins first on PATH for the programs it runs (osascript, and for a
# silence pgrep, ps and log), with a home of its own holding a report of the window server: an
# osascript that answers passes, its time said; one that never answers fails as silent once its
# time is up and, told into a folder, says the window server's pid line, the report and the log's
# last lines, keeping the log there; one that fails otherwise, or is missing, says nothing either
# way; a time that is no whole number of seconds is refused.
set -euo pipefail

server="$(dirname "$0")/window-server"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

stand_in() {
  mkdir -p "$work/$1"
  printf '#!/usr/bin/env bash\n%s\n' "$2" > "$work/$1/$3"
  chmod +x "$work/$1/$3"
}

expect() {
  local want=$1 name=$2 bin=$3 got
  shift 3
  if HOME=$work/home PATH="$work/$bin:$work/tools:$PATH" "$server" "$@" > "$work/said" 2>&1; then got=0; else got=$?; fi
  [[ $got == "$want" ]] || { echo "ci/window-server-check: $name: exit $got, not $want: $(cat "$work/said")" >&2; exit 1; }
}

said() {
  grep -qF -- "$1" "$work/said" || { echo "ci/window-server-check: $2 was not said: $(cat "$work/said")" >&2; exit 1; }
}

stand_in answers 'echo 1440' osascript
stand_in silent 'exec sleep 30' osascript
stand_in fails 'echo "no such object" >&2; exit 3' osascript
mkdir -p "$work/missing"
ln -s "$(command -v bash)" "$(command -v perl)" "$work/missing/"
stand_in tools 'echo 4242' pgrep
stand_in tools 'echo "4242 Sun Nov 22 21:00:00 2026 Ss 0.0"' ps
# shellcheck disable=SC2016
stand_in tools 'for line in $(seq 1 20); do echo "window server line $line"; done' log
mkdir -p "$work/home/Library/Logs/DiagnosticReports"
: > "$work/home/Library/Logs/DiagnosticReports/WindowServer-2026-11-22.ips"

expect 0 "a window server that answers" answers
said 'answers a new process, in ' "an answer and its time"
began=$SECONDS
SAIL_WINDOW_SERVER_SECONDS=1 expect 1 "a window server that never answers" silent
(( SECONDS - began < 10 )) || { echo "ci/window-server-check: a silence of 1 s was said after $((SECONDS - began)) s" >&2; exit 1; }
said 'does not answer a new process within 1 s' "the silence"
SAIL_WINDOW_SERVER_SECONDS=1 expect 1 "a window server that never answers, told into a folder" silent "$work/logs"
said 'WindowServer pid, start, state, cpu: 4242 Sun Nov 22 21:00:00 2026 Ss 0.0' "the window server's pid line"
said "a report of the window server: $work/home/Library/Logs/DiagnosticReports/WindowServer-2026-11-22.ips" "the report"
said 'window server line 20' "the log's last line"
grep -q 'window server line 5$' "$work/said" && { echo "ci/window-server-check: more than the log's last 15 lines were said" >&2; exit 1; }
grep -qx 'window server line 1' "$work/logs/window-server.log" || { echo "ci/window-server-check: a silence told into a folder kept no log there" >&2; exit 1; }
expect 2 "an asking process that fails otherwise" fails
said 'exit 3), which says nothing of it: no such object' "the failure in its words"
if PATH=$work/missing "$server" > "$work/said" 2>&1; then got=0; else got=$?; fi
[[ $got == 2 ]] || { echo "ci/window-server-check: no asking process to run: exit $got, not 2: $(cat "$work/said")" >&2; exit 1; }
SAIL_WINDOW_SERVER_SECONDS=soon expect 2 "a time that is no whole number" answers
echo "ci/window-server-check: ci/window-server passed, failed and refused the 6 stand-ins as it must"
