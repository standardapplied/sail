#!/usr/bin/env bash
# Temporary: each mutant must turn its named check red on this Mac. Run once, then removed.
set -uo pipefail
cd "$(dirname "$0")/.."
swift build --build-tests > /dev/null 2>&1 || { echo "the unmutated build fails" >&2; exit 1; }
missed=0

mutant() {
  local name=$1 file=$2 expression=$3 filter=$4
  cp "$file" "$file.orig"
  perl -0pi -e "$expression" "$file"
  if cmp -s "$file" "$file.orig"; then
    echo "NOT APPLIED  $name"; missed=1
  elif ! swift build --build-tests > "$RUNNER_TEMP/mutant-build.log" 2>&1; then
    echo "NO BUILD     $name"; tail -5 "$RUNNER_TEMP/mutant-build.log"; missed=1
  elif perl -e 'alarm shift; exec @ARGV' 200 swift test --skip-build --filter "$filter" > "$RUNNER_TEMP/mutant-test.log" 2>&1; then
    echo "GREEN        $name ($filter)"; missed=1
  else
    echo "RED          $name: $(grep -m1 -E 'recorded an issue|Time limit' "$RUNNER_TEMP/mutant-test.log" | cut -c1-160)"
  fi
  mv "$file.orig" "$file"
  touch "$file"
}

mutant "evict a glyph a frame in flight uses" ../SailKit/Sources/SailSurface/Atlas.swift \
  's/\$0\.value\.lastUsed <= completed && //' 'SailRendererTests\.RendererTests/aFrameInFlight'
mutant "blend dim at 0%" ../SailKit/Sources/SailVT/Palette.swift \
  's/dimming = 0\.45/dimming = 0.0/' 'SailRendererTests\.GoldenTests'
mutant "copy without joining wrapped rows" ../SailKit/Sources/SailVT/TerminalCore.swift \
  's/var unwrap = true/var unwrap = false/' 'SailTerminalViewTests\.ViewTests/aDragAcross'
mutant "send marked text before the commit" Sources/SailTerminalView/TerminalView+Keys.swift \
  's/(composition\.mark\(Self\.plain\(string\)\))/$1\n        send(KeyInput(key: .unidentified, text: Self.plain(string)), at: 0)/' 'SailTerminalViewTests\.ViewTests/composing'
mutant "do not resume the display link on output" Sources/SailTerminalView/TerminalView.swift \
  's/(private func outputArrived\(\) \{)\n        pacer\.resume\(\)/$1/' 'SailTerminalViewTests\.ViewTests/outputIsDrawn'

echo "--- hold output 16 ms before resuming the display link, measured by the drive"
file=Sources/SailTerminalView/TerminalView.swift
cp "$file" "$file.orig"
perl -0pi -e 's/(\n(\s+)await self\?\.outputArrived\(\))/\n$2try? await Task.sleep(for: .milliseconds(16))$1/' "$file"
if cmp -s "$file" "$file.orig"; then echo "NOT APPLIED  hold 16 ms"; missed=1; else
  swift build -c release > /dev/null 2>&1 && ci/bundle SailDrive "$RUNNER_TEMP/mutant/Sail Terminal Preview.app" "$SAIL_BINARY" sh.standardapplied.sail.terminal-preview.mutant > /dev/null
  cat > "$RUNNER_TEMP/mutant.json" <<'JSON'
{"steps": [
  {"name": "cat", "type": "cat\r"},
  {"name": "measure", "measure": 100, "interval": 50}
]}
JSON
  if perl -e 'alarm shift; exec @ARGV' 200 "$RUNNER_TEMP/mutant/Sail Terminal Preview.app/Contents/MacOS/SailDrive" --drive "$RUNNER_TEMP/mutant.json" --out "$RUNNER_TEMP/mutant-out" | tail -2; then
    echo "GREEN        hold 16 ms"; missed=1
  else
    echo "RED          hold 16 ms: the drive's budgets missed"
  fi
fi
mv "$file.orig" "$file"
exit $missed
