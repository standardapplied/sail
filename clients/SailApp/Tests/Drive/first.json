{"steps": [
  {"name": "type-echo-hi", "type": "echo hi\r"},
  {"name": "shows-hi", "line": "hi", "seconds": 30},
  {"name": "plain-prompt", "type": "PS1='$ '; PROMPT='$ '; clear\r"},
  {"name": "prompt", "line": "$", "seconds": 10},
  {"name": "cat-for-echo", "type": "cat\r"},
  {"name": "three-drawables", "drawables": 3},
  {"name": "measure-3-drawables", "measure": 200, "interval": 50},
  {"name": "two-drawables", "drawables": 2},
  {"name": "measure-2-drawables", "measure": 200, "interval": 50},
  {"name": "back-to-three", "drawables": 3},
  {"name": "end-cat", "press": "c", "modifiers": ["control"]},
  {"name": "prompt-after-cat", "line": "$", "seconds": 10},
  {"name": "open-less", "type": "seq 1 200 | less\r"},
  {"name": "less-top", "top": "1", "seconds": 10},
  {"name": "wheel-in-less", "scroll": 5},
  {"name": "less-scrolled", "top": "6", "seconds": 5},
  {"name": "quit-less", "type": "q"},
  {"name": "history", "type": "clear; seq 1 500\r"},
  {"name": "history-shown", "line": "500", "seconds": 10},
  {"name": "output-on-the-way", "type": "sleep 2; echo late-$((40+2))\r"},
  {"name": "wheel-up", "scroll": -40},
  {"name": "stays-scrolled", "still": true, "seconds": 4},
  {"name": "typing-returns", "type": " "},
  {"name": "back-at-bottom", "line": "late-42", "seconds": 5},
  {"name": "clear-line", "press": "u", "modifiers": ["control"]},
  {"name": "narrower", "resize": [700, 640]},
  {"name": "ask-columns-once-the-size-held", "type": "sleep 0.5; tput cols\r"},
  {"name": "columns-reached-host", "gridColumns": true, "seconds": 5},
  {"name": "bigger-1", "font": "bigger"},
  {"name": "bigger-2", "font": "bigger"},
  {"name": "bigger-3", "font": "bigger"},
  {"name": "at-18pt", "fontPoints": 18},
  {"name": "actual-size", "font": "reset"},
  {"name": "at-15pt", "fontPoints": 15},
  {"name": "paste-asks", "paste": "echo pasted-$((1+1))\necho pasted-$((2+1))\n", "confirm": true},
  {"name": "pasted", "line": "pasted-3", "seconds": 10},
  {"name": "flood-latency-from-zero", "resetLatency": true},
  {"name": "flood", "type": "clear; head -c 20971520 /dev/zero | tr '\\0' x | fold -w 150; echo flood-$((1+1))\r"},
  {"name": "flood-done", "line": "flood-2", "after": "xxxxxxxxxxxxxxxxxxxx", "seconds": 180},
  {"name": "flood-frames", "gapUnder": 100},
  {"name": "kill-host", "killHost": true},
  {"name": "host-restarted", "banner": "The host restarted", "seconds": 40},
  {"name": "new-session", "newSession": true},
  {"name": "new-session-works", "type": "echo after-$((2+3))\r"},
  {"name": "after-restart", "line": "after-5", "seconds": 30}
]}
