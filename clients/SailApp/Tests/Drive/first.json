{"steps": [
  {"name": "this-mac-signed-out", "select": "thisMac"},
  {"name": "this-mac-attached", "attached": true, "seconds": 30},
  {"name": "title-bar-over-this-mac", "titleBar": true},
  {"name": "type-echo-hi", "type": "echo hi\r"},
  {"name": "shows-hi", "line": "hi", "seconds": 30},
  {"name": "plain-prompt", "type": "PS1='$ '; PROMPT='$ '; clear\r"},
  {"name": "prompt", "line": "$", "seconds": 10},
  {"name": "cat-for-echo", "type": "cat\r"},
  {"name": "three-drawables", "drawables": 3},
  {"name": "measure-3-drawables", "measure": 200, "interval": 50},
  {"name": "two-drawables", "drawables": 2},
  {"name": "measure-2-drawables", "measure": 200, "interval": 50},
  {"name": "back-to-three", "drawables": 3},
  {"name": "end-cat", "press": "c", "modifiers": ["control"]},
  {"name": "prompt-after-cat", "line": "$", "seconds": 10},
  {"name": "open-less", "type": "seq 1 200 | less\r"},
  {"name": "less-top", "top": "1", "seconds": 10},
  {"name": "wheel-in-less", "scroll": 5},
  {"name": "less-scrolled", "top": "6", "seconds": 5},
  {"name": "quit-less", "type": "q"},
  {"name": "history", "type": "clear; seq 1 500\r"},
  {"name": "history-shown", "line": "500", "seconds": 10},
  {"name": "output-on-the-way", "type": "sleep 2; echo late-$((40+2))\r"},
  {"name": "wheel-up", "scroll": -40},
  {"name": "stays-scrolled", "still": true, "seconds": 5},
  {"name": "typing-returns", "type": " "},
  {"name": "back-at-bottom", "line": "late-42", "seconds": 5},
  {"name": "clear-line", "press": "u", "modifiers": ["control"]},
  {"name": "narrower", "resize": [700, 640]},
  {"name": "ask-columns-once-the-size-held", "type": "sleep 0.5; tput cols\r"},
  {"name": "columns-reached-host", "gridColumns": true, "seconds": 5},
  {"name": "bigger-1", "font": "bigger"},
  {"name": "bigger-2", "font": "bigger"},
  {"name": "bigger-3", "font": "bigger"},
  {"name": "at-18pt", "fontPoints": 18},
  {"name": "actual-size", "font": "reset"},
  {"name": "at-15pt", "fontPoints": 15},
  {"name": "paste-asks", "paste": "echo pasted-$((1+1))\necho pasted-$((2+1))\n", "confirm": true},
  {"name": "pasted", "line": "pasted-3", "seconds": 10},
  {"name": "flood-latency-from-zero", "resetLatency": true},
  {"name": "flood", "type": "clear; head -c 20971520 /dev/zero | tr '\\0' x | fold -w 150; echo flood-$((1+1))\r"},
  {"name": "flood-done-its-last-20-bytes-then-the-marker", "line": "xxxxxxxxxxxxxxxxxxxxflood-2", "seconds": 180},
  {"name": "every-output-shown-within-100-ms", "shownWithin": 100},
  {"name": "kill-host", "killHost": true},
  {"name": "host-restarted", "banner": "The host restarted", "seconds": 40},
  {"name": "new-session", "newSession": true},
  {"name": "new-session-attached", "attached": true, "seconds": 20},
  {"name": "new-session-works", "type": "echo after-$((2+3))\r"},
  {"name": "after-restart", "line": "after-5", "seconds": 30},
  {"name": "account", "select": "account"},
  {"name": "title-bar-over-the-account", "titleBar": true},
  {"name": "signed-out", "exactly": ["Sign in to Sail"]},
  {"name": "accent-is-terracotta-under-graphite", "accent": true},
  {"name": "unreachable-address", "address": "http://127.0.0.1:1"},
  {"name": "sign-in-unreachable", "signIn": true},
  {"name": "row-2", "pane": "Sail cannot reach http://127.0.0.1:1.\nCheck that this Mac is on its network and the address is right."},
  {"name": "plain-http-to-a-name", "address": "http://localhost:7979"},
  {"name": "sign-in-to-a-name", "signIn": true},
  {"name": "row-1", "pane": "Sail sends plain HTTP only to a private-network address. Use https:// for localhost."},
  {"name": "server-without-passkeys", "address": "http://127.0.0.1:7980"},
  {"name": "enroll-there", "enroll": "SAIL_DRIVE_TICKET"},
  {"name": "row-3", "pane": "http://127.0.0.1:7980 does not take passkeys yet.\nOn the control plane, run:\nsail host config set webauthn-rp-id sail.standardapplied.com"},
  {"name": "control-plane", "address": "http://127.0.0.1:7979"},
  {"name": "passkey-cancels", "passkey": "cancel"},
  {"name": "enroll-cancelled", "enroll": "SAIL_DRIVE_TICKET"},
  {"name": "row-12-enrolling", "exactly": ["Sign in to Sail", "Cancelled."]},
  {"name": "sign-in-cancelled", "signIn": true},
  {"name": "row-12", "exactly": ["Sign in to Sail", "Cancelled.", "If this Mac holds no passkey for http://127.0.0.1:7979, enroll one with a ticket from an admin."]},
  {"name": "passkey-holds-none", "passkey": "none"},
  {"name": "sign-in-holding-none", "signIn": true},
  {"name": "row-7-as-the-platform-says-it", "exactly": ["Sign in to Sail", "Cancelled.", "If this Mac holds no passkey for http://127.0.0.1:7979, enroll one with a ticket from an admin."]},
  {"name": "passkey-answers", "passkey": "credential"},
  {"name": "enroll", "enroll": "SAIL_DRIVE_TICKET"},
  {"name": "enrolled", "exactly": ["Sign in to Sail", "A passkey for @uday is on this Mac. Sign in with it."]},
  {"name": "the-same-ticket-again", "enroll": "SAIL_DRIVE_TICKET"},
  {"name": "row-5", "pane": "This enrollment ticket is used, expired or not from http://127.0.0.1:7979.\nA ticket lasts 15 minutes and enrolls one passkey. Ask an admin: sail fde enroll <handle>.\nEnrollment ticket is invalid or expired."},
  {"name": "sign-in-unsigned", "signed": false, "signIn": true},
  {"name": "row-13-unsigned", "signed": false, "pane": "Sail could not keep your sign-in in the Keychain: errSecMissingEntitlement (-34018).\nThis build is unsigned. Use a signed build."},
  {"name": "sign-in", "signed": true, "signIn": true},
  {"name": "signed-in", "signed": true, "pane": "Uday\n@uday\nadmin\nhttp://127.0.0.1:7979\nSigned in until "},
  {"name": "item-3", "signed": true, "keychain": "kept"},
  {"name": "five-ceremonies", "asked": 5}
]}
