{"steps": [
  {"name": "this-mac", "select": "thisMac"},
  {"name": "this-mac-attached", "attached": true, "seconds": 30},
  {"name": "plain-prompt", "type": "PS1='$ '; PROMPT='$ '; clear\r"},
  {"name": "prompt", "line": "$", "seconds": 10},
  {"name": "machine-state-at-rest", "machineState": true},
  {"name": "flood-bytes-made-once", "floodFile": true},
  {"name": "clocks-start", "clocks": "start"},
  {"name": "flood-1-typed-up-to-its-return", "type": "clear; cat /tmp/sail-drive-flood-lines /tmp/sail-drive-flood-tail; echo one-$((1+1))"},
  {"name": "flood-1-latency-from-zero", "resetLatency": true},
  {"name": "flood-1-return", "type": "\r"},
  {"name": "machine-state-in-a-flood", "machineState": true},
  {"name": "flood-1-done", "line": "xxxxxxxxxxxxxxxxxxxxone-2", "seconds": 180},
  {"name": "flood-1-every-output-shown-within-100-ms", "shownWithin": 100},
  {"name": "flood-2-typed-up-to-its-return", "type": "clear; cat /tmp/sail-drive-flood-lines /tmp/sail-drive-flood-tail; echo two-$((1+1))"},
  {"name": "flood-2-latency-from-zero", "resetLatency": true},
  {"name": "flood-2-return", "type": "\r"},
  {"name": "flood-2-done", "line": "xxxxxxxxxxxxxxxxxxxxtwo-2", "seconds": 180},
  {"name": "flood-2-every-output-shown-within-100-ms", "shownWithin": 100},
  {"name": "the-three-clocks", "clocks": "report"},
  {"name": "machine-state-after", "machineState": true}
]}
