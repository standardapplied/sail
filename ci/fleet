while_cut_off() {
  local run=$1 box=$2 on_main=$3 on_box=$4 main_ip rule status=0
  main_ip=$(internal_ip "$run" main)
  [[ -n $main_ip ]] || { echo "main has no address"; return 1; }
  rule="OUTPUT -d $main_ip -j REJECT"
  on "$run" "$box" "command -v iptables > /dev/null || sudo apt-get install -y -qq iptables > /dev/null 2>&1; sudo iptables -I $rule" || return 1
  trap "on $(printf %q "$run") $(printf %q "$box") $(printf %q "sudo iptables -D $rule")" EXIT INT TERM
  echo "$box cannot reach main at $main_ip"
  { on "$run" main "$on_main" && on "$run" "$box" "$on_box"; } || status=1
  on "$run" "$box" "sudo iptables -D $rule" || status=1
  trap - EXIT INT TERM
  return $status
