readonly DIRECT_TERMINAL='import json, socket, struct, sys, urllib.request
ip, token = sys.argv[1], sys.stdin.readline().strip()
def text(value):
    raw = value.encode()
    return struct.pack(">i", len(raw)) + raw
def frame(kind, payload=b""):
    return struct.pack(">i", 1 + len(payload)) + bytes([kind]) + payload
def exactly(conn, count):
    data = b""
    while len(data) < count:
        more = conn.recv(count - len(data))
        if not more:
            raise SystemExit("the host closed the connection")
        data += more
    return data
def read(conn):
    payload = exactly(conn, struct.unpack(">i", exactly(conn, 4))[0])
    return payload[0], payload[1:]
def present(ticket):
    conn = socket.create_connection((ip, 7072), timeout=30)
    conn.sendall(b"SAILPTY3")
    if exactly(conn, 8) != b"SAILPTY3":
        raise SystemExit("not a sail pty host")
    conn.sendall(frame(9, text(ticket)))
    return conn, read(conn)
asked = urllib.request.Request(
    "http://%s:7071/v1/terminal/tickets" % ip,
    data=json.dumps({"action": "open", "project": "acme"}).encode(),
    headers={"Authorization": "Bearer " + token, "Content-Type": "application/json"})
ticket = json.load(urllib.request.urlopen(asked, timeout=30))["ticket"]
conn, (kind, _) = present(ticket)
if kind != 32:
    raise SystemExit("the ticket was not welcomed: frame %d" % kind)
create = text("direct") + struct.pack(">i", 0) + text("/tmp") + text("acme") + text("")
conn.sendall(frame(1, create + struct.pack(">ii", 80, 24)))
conn.sendall(frame(2, text("direct") + b"\x01"))
line = b"echo $((6*7))-over-tcp\r"
conn.sendall(frame(3, struct.pack(">q", 1) + struct.pack(">i", len(line)) + line))
seen = b""
while b"42-over-tcp" not in seen:
    kind, payload = read(conn)
    if kind == 31:
        raise SystemExit("refused: %r" % payload)
    if kind == 20:
        seen += payload[12:]
print("the session echoed 42-over-tcp over TCP")
again, (kind, payload) = present(ticket)
if kind != 31 or b"presented already" not in payload:
    raise SystemExit("the second presentation was not refused as used: frame %d" % kind)
print("the same ticket, presented again, is refused")'

