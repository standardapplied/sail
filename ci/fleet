  check "$run" "every node syncs twice" sync_all "$run"
  check "$run" "eng applies beta" apply_project "$run" eng beta
  check "$run" "observer applies beta" apply_project "$run" observer beta
  check "$run" "eng serves beta and says its port listens" serves "$run" eng beta 'app +8080 +listening'
  check "$run" "inside eng's beta, the app answers on 8080" container_allows "$run" eng beta "curl -sf localhost:8080/ > /dev/null"
  check "$run" "inside eng's beta, the portal skill reads the port" \
    container_allows "$run" eng beta "$PORTAL ports | grep -qE '8080.*listening'"
  check "$run" "over HTTP, eng reads beta's ports" http_door "$run" eng eng 200 GET /v1/projects/beta/ports
  check "$run" "observer (viewer) cannot serve beta at the CLI" \
