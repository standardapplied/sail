#!/usr/bin/env bash
set -euo pipefail

readonly CALLER_DIR=$PWD
cd "$(dirname "$0")/.."

readonly PROJECT=${FLEET_PROJECT:-sail-mast-511621}
readonly ZONE=${FLEET_ZONE:-us-central1-a}
readonly MACHINE=${FLEET_MACHINE:-e2-standard-4}
readonly RUNS=${FLEET_RUNS:-$HOME/.sail-fleet}
readonly BOXES="main eng client observer"
readonly MAX_RUN=6h
readonly SECRETS="fleet-anthropic-key fleet-openai-key fleet-github-token"
readonly LOOP_REPO=standardapplied/nocaptcha
readonly LOOP_AGENTS=${FLEET_LOOP_AGENTS:-claude-code}

usage() {
  cat >&2 <<'EOF'
Usage:
  ci/fleet run VERSION [--upgrade-to TARGET]
                                a fresh fleet on release VERSION (e.g. 0.59.0), every scenario, then down;
                                with --upgrade-to, projects and conflicts run on VERSION, the fleet is
                                upgraded to TARGET, main first (a release version, or a native binary
                                file for sail upgrade --binary), and every other scenario runs on TARGET
  ci/fleet up RUN               create the run's four VMs and wait until each answers ssh
  ci/fleet install RUN VERSION  install release VERSION on every box from the README's install line;
                                VERSION may be a candidate binary, put in place by sail upgrade --binary
                                over the release it names
  ci/fleet join RUN             init main, join the three nodes with their roles, sync
  ci/fleet projects RUN         create acme, beta, gamma on main, grant them, check each node holds its own
  ci/fleet doors RUN            each role's spec writes at the node CLI, and where each spec syncs to
  ci/fleet conflicts RUN        the same field changed on main and offline on eng parks a conflict that
                                resolves the same everywhere; different fields merge; a conversation
                                reads the same on every box
  ci/fleet inside RUN           apply acme on client and observer; each role at the in-container spec
                                CLI and at the HTTP API Mast calls; from main, over client's private address,
                                a ticket from the API opens a session over TCP that echoes a line, and the
                                same ticket is refused a second time
  ci/fleet rooms RUN            client opens a room over HTTP; who may post in it at each door, and the
                                conversation reads the same on every box; no other project's room leaks
  ci/fleet access RUN           the access matrix's rows, at each door that offers them: client comments on
                                eng's e1 and claims an open spec, but cannot edit, reassign or retell a review
                                of e1, claim a spec born in eng's room r1, read beta's ids, or keep one, or an
                                offline edit main refuses, past a sync; eng dispatches e1 on its own box as a
                                dry run, and uday's dispatch of it on main is placement; eng cannot add a
                                person at its node's CLI or at main's gateway; main refuses a sync session
                                whose token is no session; eng reads sync health and bus stats on its own
                                box but not on main, nor runs main's rounds; row 4, a push into a project
                                client is not granted, is proven by the unit tests (AccessScenarioTest row
                                4), as client's box drops an ungranted project before it offers anything and
                                only a forged sync client reaches main; row 26, a disabled person's passkey
                                enrollment, by the unit tests until sail-people-are-managed adds disable
  ci/fleet files RUN            files shared on main and on client reach exactly the nodes granted their
                                project, updates and removals follow, and a viewer cannot share
  ci/fleet portal RUN           main declares beta's app; eng serves it, it answers in the container, at
                                the portal skill and over HTTP; the viewer cannot bring it up at any door
  ci/fleet resilience RUN       incus is held everywhere; on client, sail-api, the pty host and incus restart
                                under a live session: sync, the session and the container door hold or say why
  ci/fleet loop RUN             on eng, the loop's agents build and review a spec in acme on nocaptcha: its
                                build asks a question and waits, eng answers, and it goes on to
                                awaiting_merge; the pull request, the room and every box's status are checked,
                                main's measures of the spec count the reviews and the build runs listed for it,
                                no secret reaches a log, and the pull request is closed
  ci/fleet rebuilt RUN VERSION  main is copied by the README's backup line, takes a spec, and is lost; client
                                writes while it is gone; a new main installs VERSION and inits empty, which
                                observer refuses as another org; the copy goes in place, every node re-pins
                                main, drops the lost spec into its history, and pushes what main never had
  ci/fleet upgrade RUN TARGET   upgrade main, then every node, to TARGET, and check that the projects
                                and the conflicts scenario's spec and conversation held
  ci/fleet ssh RUN BOX COMMAND  run COMMAND on BOX as the operator account
  ci/fleet down [RUN]           delete the run's VMs, or every fleet VM when RUN is left out

Each step logs to $FLEET_RUNS/RUN/ (default ~/.sail-fleet); report.txt holds one line per check.
FLEET_KEEP=1 leaves a failed run's VMs up for diagnosis; FLEET_KEEP=always leaves any run's up.
FLEET_LOOP=0 skips the agent loop, which needs the fleet-* secrets and spends model tokens;
FLEET_LOOP_AGENTS names the agents it installs, builder first (default: claude-code; add codex to have it review).
EOF
  exit 2
}

vm() { echo "sail-fleet-$1-$2"; }

from_caller() {
  if [[ $1 != /* && -f $CALLER_DIR/$1 ]]; then
    echo "$CALLER_DIR/$1"
  else
    echo "$1"
  fi
}

gc() { gcloud --project "$PROJECT" --quiet "$@"; }

on() {
  local run=$1 box=$2
  shift 2
  gc compute ssh "$(vm "$run" "$box")" --zone "$ZONE" --command "$*" \
    -- -o ConnectTimeout=15 -o ServerAliveInterval=30 -o BatchMode=yes
}

log_dir() {
  mkdir -p "$RUNS/$1"
  echo "$RUNS/$1"
}

check() {
  local run=$1 name=$2
  shift 2
  local dir log
  dir=$(log_dir "$run")
  log="$dir/$(echo "$name" | tr -c 'A-Za-z0-9._-' '_').log"
  if "$@" > "$log" 2>&1; then
    echo "PASS $name" | tee -a "$dir/report.txt"
  else
    echo "FAIL $name (see $log)" | tee -a "$dir/report.txt"
    return 1
  fi
}

internal_ip() {
  gc compute instances describe "$(vm "$1" "$2")" --zone "$ZONE" \
    --format='value(networkInterfaces[0].networkIP)'
}

create_vm() {
  gc compute instances create "$(vm "$1" "$2")" --zone "$ZONE" --machine-type "$MACHINE" \
    --image-family ubuntu-2404-lts-amd64 --image-project ubuntu-os-cloud \
    --boot-disk-size 50GB --boot-disk-type pd-balanced \
    --provisioning-model STANDARD --instance-termination-action DELETE --max-run-duration "$MAX_RUN" \
    --labels "purpose=sail-fleet,run=$1,box=$2" > /dev/null
}

answers_ssh() {
  local attempt
  for attempt in $(seq 1 30); do
    on "$1" "$2" true > /dev/null 2>&1 && return 0
    sleep 5
  done
  echo "ci/fleet: $2 never answered ssh." >&2
  return 1
}

up() {
  local run=${1:-} box
  [[ -n $run ]] || usage
  for box in $BOXES; do
    create_vm "$run" "$box" &
  done
  wait
  for box in $BOXES; do
    answers_ssh "$run" "$box" || exit 1
  done
}

install_box() {
  local run=$1 box=$2 version=$3 release
  if [[ -f $version ]]; then
    release=$("$version" -V | awk '{print $2}')
    on "$run" "$box" "curl -fsSL https://raw.githubusercontent.com/standardapplied/sail/main/install.sh | bash -s $release"
    gc compute scp "$version" "$(vm "$run" "$box"):/tmp/sail-candidate" --zone "$ZONE"
    on "$run" "$box" "sudo sail upgrade --binary /tmp/sail-candidate && sudo sha256sum \"\$(command -v sail)\""
  else
    on "$run" "$box" "curl -fsSL https://raw.githubusercontent.com/standardapplied/sail/main/install.sh | bash -s $version && sail -V"
  fi
}

install() {
  local run=${1:-} version box pid failed=0 pids=""
  version=$(from_caller "${2:-}")
  [[ -n $run && -n $version ]] || usage
  for box in $BOXES; do
    check "$run" "install $version on $box" install_box "$run" "$box" "$version" &
    pids="$pids $!"
  done
  for pid in $pids; do
    wait "$pid" || failed=1
  done
  return $failed
}

init_main() {
  on "$1" main "sudo sail init --as-main --handle uday --name 'Uday Fleet' --email uday@fleet.example"
}

join_node() {
  local run=$1 box=$2 handle=$3 role=$4 scoped=$5 main_ip=$6 dir
  dir=$(log_dir "$run")
  on "$run" "$box" "sudo sail init --main $main_ip --handle $handle --name '${handle^} Fleet' --email $handle@fleet.example" \
    | tee "$dir/init-$box.out"
  local line
  line=$(grep -m1 -oE "sudo sail fde add .*" "$dir/init-$box.out" | sed -E "s/--role [a-z]+/--role $role/")
  if [[ -z $line ]]; then
    echo "ci/fleet: $box's init printed no fde add line." >&2
    return 1
  fi
  if [[ $scoped == scoped ]]; then
    line="$line --scoped"
  fi
  on "$run" main "$line"
  on "$run" "$box" "sudo sail sync && sudo sail sync status --json"
}

join() {
  local run=${1:-}
  [[ -n $run ]] || usage
  check "$run" "init main as uday (admin)" init_main "$run"
  local main_ip
  main_ip=$(internal_ip "$run" main)
  check "$run" "join eng (member, every project)" join_node "$run" eng eng member all "$main_ip"
  check "$run" "join client (member, scoped)" join_node "$run" client client member scoped "$main_ip"
  check "$run" "join observer (viewer, scoped)" join_node "$run" observer obs viewer scoped "$main_ip"
  check "$run" "main's roster has every FDE with its role" roster "$run"
}

roster() {
  local listed
  listed=$(on "$1" main "sudo sail fde list" | tr -s ' ')
  echo "$listed"
  local row
  for row in "client Client Fleet client@fleet.example member active" \
    "eng Eng Fleet eng@fleet.example member active all" \
    "obs Obs Fleet obs@fleet.example viewer active" \
    "uday Uday Fleet uday@fleet.example admin active all"; do
    grep -qF "$row" <<< "$listed" || { echo "missing: $row"; return 1; }
  done
}

create_project() {
  on "$1" main "echo '{\"name\":\"$2\",\"resources\":{\"cpu\":2,\"memory\":\"4GB\",\"disk\":\"20GB\"}}' | sudo sail project create $2 --definition -"
}

holds() {
  local run=$1 box=$2 expected=$3 listed
  on "$run" "$box" "sudo sail sync" > /dev/null
  listed=$(on "$run" "$box" "sudo sail project list --json 2>/dev/null" \
    | python3 -I -c 'import json,sys; print(" ".join(sorted(p["name"] for p in json.load(sys.stdin))))')
  echo "$box holds: $listed"
  [[ $listed == "$expected" ]]
}

holds_no_trace_of() {
  local run=$1 box=$2 counts
  shift 2
  counts=$(on "$run" "$box" "sudo apt-get install -y -qq sqlite3 > /dev/null 2>&1; for w in $*; do printf '%s=%s ' \$w \$(sudo sqlite3 -readonly /root/.sail/sail.db .dump | grep -ci \"\\b\$w\\b\"); done")
  echo "$box: $counts"
  ! grep -qE '=[1-9]' <<< "$counts"
}

allowed() {
  local run=$1 box=$2
  shift 2
  on "$run" "$box" "$*"
}

refused() {
  local run=$1 box=$2 because=$3 out
  shift 3
  if out=$(on "$run" "$box" "$*" 2>&1); then
    echo "$out"
    echo "expected a refusal"
    return 1
  fi
  echo "$out"
  grep -qF "$because" <<< "$out"
}

naming() {
  local text=$1 out
  shift
  if ! out=$("$@"); then
    echo "$out"
    return 1
  fi
  echo "$out"
  grep -qF "$text" <<< "$out" || { echo "it does not name: $text"; return 1; }
}

spec_ids() {
  on "$1" "$2" "sudo sail spec list --all-projects --all --json --no-sync 2>/dev/null" \
    | python3 -I -c 'import json,sys; print(" ".join(sorted(s["project"] + "/" + s["id"] for s in json.load(sys.stdin)["specs"])))'
}

specs_on() {
  local run=$1 box=$2 expected=$3 listed
  listed=$(spec_ids "$run" "$box")
  echo "$box holds: $listed"
  [[ $listed == "$expected" ]]
}

union() {
  printf '%s\n' $* | sort -u | paste -sd ' ' -
}

in_acme() {
  printf '%s\n' $* | grep '^acme/' | sort -u | paste -sd ' ' -
}

sync_all() {
  local run=$1 round box
  for round in 1 2; do
    for box in eng client observer; do
      on "$run" "$box" "sudo sail sync" > /dev/null
    done
  done
}

reaches_main_unasked() {
  local run=$1 spec=$2 attempt
  for attempt in $(seq 1 10); do
    if on "$run" main "sudo sail spec show $spec --no-sync" > /dev/null 2>&1; then
      echo "on main after about $((attempt * 3)) s"
      return 0
    fi
    sleep 3
  done
  echo "not on main after 30 s"
  return 1
}

readonly VIEWER_POSTS='Your credential is read-only and cannot post in rooms.'
readonly VIEWER_FIX='Ask an admin for a member or admin credential.'
readonly E1_IS_ENGS="Spec 'e1' is assigned to 'eng', not you."
readonly ASK_ENG='Ask eng to make this change, or have an admin do it.'
readonly R1_IS_ENGS="'r1' belongs to eng: only eng or an admin may start work there, not you."
readonly ASK_ADMIN_TO_ASSIGN='Ask an admin to assign it to you.'
readonly E1_ADMIN_ONLY="Reassigning spec 'e1' moves work between FDEs and is an admin-only action (currently 'eng')."
readonly ASK_AN_ADMIN='Ask an admin to reassign it. You may grab a spec only while it is unassigned.'
readonly E1_NOT_CLIENTS="Event type 'review_completed' makes this box act on 'e1' (owned by 'eng'), which you may not drive."
readonly ASK_E1S_OWNER='Only its owner or an admin may publish it.'
readonly E1_RUNS_ON_ENG="Spec 'e1' is assigned to 'eng', which runs on that FDE's devbox, not this node ('uday')."
readonly E1_IS_A_DRAFT="Spec 'e1' is a draft. A spec is dispatched only when pending."
readonly ADMIN_MANAGES_PEOPLE='Only an admin may manage people.'
readonly ASK_AN_ADMIN_TO_DO_IT='Ask an admin to do it.'
readonly MAIN_IS_UDAYS="Box 'uday' belongs to 'uday', not you."
readonly ASK_UDAY_TO_OPERATE='Ask uday to operate it, or have an admin do it.'
readonly AGENT_VERB_RUNS_AS_THE_BOX="'agent stop' reads this box's control plane directly, as the box's own person, so it is not available over an SSH-key session."
readonly FOLLOW_WITH_SPEC="Follow the work with 'sail spec' and the board, or SSH to the host directly to run it."
readonly NO_SYNC_SESSION='sync: main serves no session whose token is missing, invalid or expired'
readonly CONTAINER_CANNOT_APPROVE='The credential in a project container cannot approve specs.'
readonly PROMOTE_FROM_OUTSIDE="Do it from outside the container: 'sail spec update e21 --status <status>' on the host, or Mast."
readonly CONTAINER_CANNOT_SHARE='The credential in a project container cannot share files and skills in projects.'
readonly SHARE_FROM_OUTSIDE="Do it from outside the container: 'sail project skills add --container <folder> -p acme' or 'sail project skills rm <skill> -p acme' on the host, or Mast."
readonly FLEET_SKILL='mkdir -p /home/dev/fleet-skill && printf -- "---\\nname: fleet-skill\\ndescription: A fleet check.\\n---\\nCheck.\\n" > /home/dev/fleet-skill/SKILL.md'

doors() {
  local run=${1:-} before
  [[ -n $run ]] || usage
  before=$(spec_ids "$run" main)
  check "$run" "client creates a spec with no sync" \
    allowed "$run" client "sudo sail spec create -p acme --id unasked --title 'reaches main by itself'"
  check "$run" "it reaches main within 30 s, no sail sync asked" reaches_main_unasked "$run" unasked
  check "$run" "observer (viewer) cannot create a spec" \
    refused "$run" observer "credential is read-only" "sudo sail spec create -p acme --id obs-try --title 'viewer writes'"
  check "$run" "client creates a spec in acme" \
    allowed "$run" client "sudo sail spec create -p acme --id client-acme --title 'client in acme'"
  check "$run" "client cannot create a spec in beta, which it was never granted" \
    refused "$run" client "sudo sail fde grant client beta" "sudo sail spec create -p beta --id client-beta --title 'client in beta'"
  check "$run" "eng creates a spec in gamma" \
    allowed "$run" eng "sudo sail spec create -p gamma --id eng-gamma --title 'eng in gamma'"
  check "$run" "every node syncs twice" sync_all "$run"
  check "$run" "matrix 1: obs reads acme's spec client-acme [CLI]" allowed "$run" observer "sudo sail spec show client-acme"
  check "$run" "matrix 2: obs comments on client-acme, refused read-only, naming the fix [CLI]" \
    naming "$VIEWER_FIX" refused "$run" observer "$VIEWER_POSTS" "sudo sail spec comment client-acme --body 'a viewer speaks'"
  local added="acme/client-acme acme/unasked gamma/eng-gamma"
  check "$run" "main holds the three new specs" specs_on "$run" main "$(union $before $added)"
  check "$run" "eng holds the three new specs" specs_on "$run" eng "$(union $before $added)"
  check "$run" "client holds the acme specs alone" specs_on "$run" client "$(in_acme $before $added)"
  check "$run" "observer holds the acme specs alone" specs_on "$run" observer "$(in_acme $before $added)"
}

projects() {
  local run=${1:-} p
  [[ -n $run ]] || usage
  for p in acme beta gamma; do
    check "$run" "main creates $p" create_project "$run" "$p"
  done
  check "$run" "main grants client acme, obs acme and beta" \
    on "$run" main "sudo sail fde grant client acme && sudo sail fde grant obs acme && sudo sail fde grant obs beta"
  check "$run" "eng holds every project" holds "$run" eng "acme beta demo gamma"
  check "$run" "client holds acme alone" holds "$run" client "acme"
  check "$run" "observer holds acme and beta" holds "$run" observer "acme beta"
  check "$run" "matrix 3: main sends client nothing of beta, gamma or demo, and its database has no trace of them [sync]" holds_no_trace_of "$run" client beta gamma demo
  check "$run" "observer's database has no trace of gamma or demo" holds_no_trace_of "$run" observer gamma demo
}

in_container() {
  local run=$1 box=$2 project=$3
  shift 3
  printf '%s; exit\n' "$*" | on "$run" "$box" "sudo script -qec 'sail project shell $project' /dev/null"
}

container_allows() {
  local out
  out=$(in_container "$1" "$2" "$3" "$4; echo DOOR_EXIT=\$?")
  echo "$out"
  grep -q "DOOR_EXIT=0" <<< "$out"
}

container_refuses() {
  local out
  out=$(in_container "$1" "$2" "$3" "$5; echo DOOR_EXIT=\$?")
  echo "$out"
  ! grep -q "DOOR_EXIT=0" <<< "$out" && grep -qF "$4" <<< "$out"
}

readonly HTTP_DOOR='set -u
handle=$1 method=$2 path=$3 body=${4:-}
code=$(sudo sail fde pair "$handle" --host 127.0.0.1 2>/dev/null | grep -oE "sail1\.[A-Za-z0-9_-]+" | head -1)
[ -n "$code" ] || { echo "no connect code"; exit 1; }
json=$(printf "%s" "${code#sail1.}" | tr "_-" "/+" | base64 -d 2>/dev/null)
field() { printf "%s" "$json" | python3 -c "import json,sys; print(json.load(sys.stdin)[\"$1\"])"; }
token=$(field token); server=$(field server)
if [ "$method" = GET ]; then
  status=$(curl -s -o /tmp/door.json -w "%{http_code}" -H "Authorization: Bearer $token" "$server$path")
else
  status=$(curl -s -o /tmp/door.json -w "%{http_code}" -X "$method" -H "Authorization: Bearer $token" \
    -H "Content-Type: application/json" -d "$body" "$server$path")
fi
sudo sail fde unpair "$handle" > /dev/null 2>&1
echo "HTTP $status"; head -c 400 /tmp/door.json; echo'

http_door() {
  local run=$1 box=$2 handle=$3 expected=$4 method=$5 path=$6 body=${7:-} says=${8:-} out
  out=$(on "$run" "$box" "cat > /tmp/sail-http-door && bash /tmp/sail-http-door $handle $method '$path' '$body'" <<< "$HTTP_DOOR")
  echo "$out"
  grep -q "^HTTP $expected$" <<< "$out" && grep -qF "$says" <<< "$out"
}

readonly HTTP_TOKEN_DOOR='set -u
handle=$1 role=$2 method=$3 path=$4 body=$5
token=$(sudo sail server token create "door-$handle" "$role" --fde "$handle" 2>/dev/null | sed -n 2p | tr -d " ")
[ -n "$token" ] || { echo "no token"; exit 1; }
if [ "$method" = GET ]; then
  status=$(curl -s -o /tmp/door.json -w "%{http_code}" -H "Authorization: Bearer $token" "http://127.0.0.1:7070$path")
else
  status=$(curl -s -o /tmp/door.json -w "%{http_code}" -X "$method" -H "Authorization: Bearer $token" \
    -H "Content-Type: application/json" -d "$body" "http://127.0.0.1:7070$path")
fi
sudo sail server token revoke "door-$handle" > /dev/null 2>&1
echo "HTTP $status"; head -c 400 /tmp/door.json; echo'

http_token_door() {
  local run=$1 box=$2 handle=$3 role=$4 expected=$5 method=$6 path=$7 body=${8:-} says=${9:-} out
  out=$(on "$run" "$box" "cat > /tmp/sail-token-door && bash /tmp/sail-token-door $handle $role $method '$path' '$body'" <<< "$HTTP_TOKEN_DOOR")
  echo "$out"
  grep -q "^HTTP $expected$" <<< "$out" && grep -qF "$says" <<< "$out"
}

gateway_door() {
  local run=$1 box=$2 says=$3 main_ip
  shift 3
  main_ip=$(internal_ip "$run" main)
  [[ -n $main_ip ]] || { echo "main has no address"; return 1; }
  refused "$run" "$box" "$says" \
    "sudo ssh -o BatchMode=yes -o IdentitiesOnly=yes -i /root/.sail/sync_ed25519 sail@$main_ip sail $*"
}

gateway_allows() {
  local run=$1 box=$2 main_ip
  shift 2
  main_ip=$(internal_ip "$run" main)
  [[ -n $main_ip ]] || { echo "main has no address"; return 1; }
  allowed "$run" "$box" \
    "sudo ssh -o BatchMode=yes -o IdentitiesOnly=yes -i /root/.sail/sync_ed25519 sail@$main_ip sail $*"
}

apply_project() {
  on "$1" "$2" "sudo sail project apply $3 --yes"
}

spec_field() {
  on "$1" "$2" "sudo sail spec show $3 --no-sync --json 2>/dev/null" \
    | python3 -I -c "import json,sys; d=json.load(sys.stdin); print(d.get('spec', d).get('$4'))"
}

everywhere() {
  local run=$1 spec=$2 field=$3 expected=$4 box value
  for box in main eng client observer; do
    value=$(spec_field "$run" "$box" "$spec" "$field")
    echo "$box: $field=$value"
    [[ $value == "$expected" ]] || return 1
  done
}

parks_one_conflict() {
  local out listed
  out=$(on "$1" eng "sudo sail sync" 2>&1)
  echo "$out"
  grep -qF "1 conflict(s) need your decision" <<< "$out" || return 1
  listed=$(on "$1" eng "sudo sail conflicts --json")
  echo "$listed"
  grep -qF '"entity": "shared", "fields": ["title"]' <<< "$listed"
}

merges_without_conflict() {
  local out
  out=$(on "$1" eng "sudo sail sync" 2>&1)
  echo "$out"
  grep -qF "1 merged" <<< "$out" && [[ $(on "$1" eng "sudo sail conflicts --json") == "[]" ]]
}

conversation_matches() {
  local run=$1 room=$2 box first="" digest
  for box in main eng client observer; do
    digest=$(on "$run" "$box" "sudo sail spec comments $room --no-sync" | md5sum | cut -c1-12) || return 1
    echo "$box: $digest"
    [[ -z $first ]] && first=$digest
    [[ $digest == "$first" ]] || return 1
  done
}

conflicts() {
  local run=${1:-}
  [[ -n $run ]] || usage
  check "$run" "client creates spec shared in acme and syncs" \
    allowed "$run" client "sudo sail spec create -p acme --id shared --title 'first title' && sudo sail sync"
  check "$run" "main assigns shared to eng" allowed "$run" main "sudo sail spec update shared --assignee eng"
  check "$run" "eng renames shared without syncing" \
    allowed "$run" eng "sudo sail sync && sudo sail spec update shared --title \"eng's title\" --no-sync"
  check "$run" "main renames shared too" allowed "$run" main "sudo sail spec update shared --title \"uday's title\""
  check "$run" "eng's sync parks one conflict on the title and names the next step" parks_one_conflict "$run"
  check "$run" "eng takes main's side" allowed "$run" eng "sudo sail conflicts resolve shared --theirs && sudo sail sync"
  check "$run" "every node syncs twice" sync_all "$run"
  check "$run" "every box holds main's title" everywhere "$run" shared title "uday's title"
  check "$run" "every box credits it to uday" everywhere "$run" shared updated_by uday
