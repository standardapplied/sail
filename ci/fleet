    naming "$PROMOTE_FROM_OUTSIDE" container_refuses "$run" eng acme "$CONTAINER_CANNOT_APPROVE" "spec update e21 --status done"
  check "$run" "matrix 21: eng's in-container credential shares a skill, refused naming the container lane [socket]" \
