  check "$run" "every node syncs twice" sync_all "$run"
  check "$run" "eng, client and observer read notes.md" file_everywhere "$run" acme notes.md "acme notes v1" eng client observer
  check "$run" "eng and observer read betaonly.md" file_everywhere "$run" beta betaonly.md "beta notes" eng observer
  check "$run" "client cannot read beta's file" \
    refused "$run" client "Project 'beta' is not in the catalog" "sudo sail project files cat betaonly.md -p beta"
  check "$run" "client's database has no trace of betaonly" holds_no_trace_of "$run" client betaonly
  check "$run" "client's synced copy of notes.md is on its disk" \
    allowed "$run" client "sudo grep -qx 'acme notes v1' /root/.sail/projects/acme/files/notes.md"
  check "$run" "observer cannot share a file" \
    refused "$run" observer "credential is read-only" "printf x > /tmp/obs.md && sudo sail project files add /tmp/obs.md -p acme"
  check "$run" "client shares plan.md in acme" share "$run" client acme plan.md "the client plan"
  check "$run" "client updates notes.md" share "$run" client acme notes.md "acme notes v2"
  check "$run" "every node syncs twice more" sync_all "$run"
  check "$run" "main, eng and observer read client's plan.md" file_everywhere "$run" acme plan.md "the client plan" main eng observer
  check "$run" "every box reads client's notes.md" file_everywhere "$run" acme notes.md "acme notes v2" main eng client observer
  check "$run" "client stops sharing plan.md" allowed "$run" client "sudo sail project files rm plan.md -p acme"
  check "$run" "every node syncs to hear it" sync_all "$run"
  check "$run" "plan.md is gone from every box" file_gone "$run" acme plan.md main eng client observer
}

readonly PORTAL='$(find /home/dev -path "*sail-portal/scripts/portal" -print -quit)'

serves() {
  local out
  out=$(on "$1" "$2" "sudo sail project serve $3") || { echo "$out"; return 1; }
  echo "$out"
  grep -qE "$4" <<< "$out"
}

portal() {
  local run=${1:-}
  [[ -n $run ]] || usage
  check "$run" "main declares beta's app on port 8080" \
    on "$run" main "echo '{\"app\":{\"command\":\"python3 -m http.server 8080\",\"port\":8080}}' | sudo sail project config set beta processes -"
  check "$run" "main declares codex as beta's agent, so its skills are installed" \
