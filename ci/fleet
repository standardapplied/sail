    naming "$PROMOTE_FROM_OUTSIDE" container_refuses "$run" eng acme "$CONTAINER_CANNOT_APPROVE" "spec update e21 --status pending"
  check "$run" "matrix 21: eng sets e21 ready from the host: the control [CLI]" \
