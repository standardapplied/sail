direct_terminal() {
  local run=$1 ip token status=0
  ip=$(internal_ip "$run" client)
  [[ -n $ip ]] || { echo "client has no address"; return 1; }
  token=$(on "$run" client "cat > /tmp/sail-listen-privately && bash /tmp/sail-listen-privately $ip" <<< "$LISTEN_PRIVATELY")
  if [[ -z $token ]]; then
    echo "no token for client"
    status=1
  else
    on "$run" main "cat > /tmp/sail-direct-terminal.py" <<< "$DIRECT_TERMINAL" || status=1
    [[ $status == 0 ]] && { on "$run" main "python3 /tmp/sail-direct-terminal.py $ip" <<< "$token" || status=1; }
  fi
  on "$run" client "cat > /tmp/sail-close-privately && bash /tmp/sail-close-privately" <<< "$CLOSE_PRIVATELY" || status=1
  return $status
}

