denied_at_sync() {
  local run=$1 box=$2 spec=$3 reason=$4 said denial
  for _ in $(seq 1 10); do
    said=$({
      on "$run" "$box" "sudo sail sync" 2>&1
      on "$run" "$box" "sudo journalctl -u sail-api --since '-15min' --no-pager -o cat"
    })
    denial=$(grep -F "spec $spec: main denied this change" <<< "$said" | grep -F "$reason" | grep -F "Yours is in its history")
    if [[ -n $denial ]]; then
      echo "$denial"
      return 0
    fi
    sleep 3
  done
  echo "$said" | tail -20
  echo "no denial of $spec naming: $reason"
  return 1
}

