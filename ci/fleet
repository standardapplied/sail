  check "$run" "over HTTP, the viewer cannot serve beta" http_door "$run" observer obs 403 POST /v1/projects/beta/serve '{}'
  check "$run" "inside observer's beta, the portal skill cannot bring it up" \
    container_refuses "$run" observer beta "read_only_credential" "$PORTAL up 5"
  check "$run" "eng stops beta's processes" on "$run" eng "sudo sail project serve beta --stop"
  check "$run" "inside eng's beta, the app no longer answers" \
    container_refuses "$run" eng beta "" "curl -sf localhost:8080/ > /dev/null"
}

session_is() {
  local run=$1 box=$2 name=$3 expected=$4 attempt state
  for attempt in $(seq 1 10); do
    state=$(on "$run" "$box" "sudo sail session ls" | awk -v n="$name" '$1 == n {print $2}')
    echo "$name: ${state:-absent}"
    [[ $state == "$expected" ]] && return 0
    sleep 3
  done
  return 1
}

opens_session() {
  local run=$1 box=$2 name=$3
  on "$run" "$box" "sudo sail session new $name --project acme --command bash -c 'while :; do date; sleep 1; done'" || return 1
  on "$run" "$box" "{ sleep 3; printf '\\035'; } | sudo script -qec 'sail session attach $name' /dev/null | tr -d '\\r' | grep -q 'the session lives on'"
}

held_everywhere() {
  local run=$1 box
  for box in $BOXES; do
    echo "$box: $(on "$run" "$box" "apt-mark showhold | paste -sd ' ' -")"
    on "$run" "$box" "apt-mark showhold | grep -qx incus" || return 1
    on "$run" "$box" "grep -rqs incus /etc/needrestart/conf.d/" || { echo "$box: no needrestart policy names incus"; return 1; }
  done
}

resilience() {
  local run=${1:-}
  [[ -n $run ]] || usage
  check "$run" "every box holds incus, and needrestart may not restart it" held_everywhere "$run"
  check "$run" "client opens a ticking session in acme, attaches and detaches" opens_session "$run" client ticker
  check "$run" "the session is live" session_is "$run" client ticker live
  check "$run" "incus upgrade's dry run changes nothing" allowed "$run" client "sudo sail host incus upgrade --dry-run"
  check "$run" "the session is still live after the dry run" session_is "$run" client ticker live
  check "$run" "sail-api restarts on client" on "$run" client "sudo systemctl restart sail-api"
  check "$run" "client writes a spec with no sync after the restart" \
    allowed "$run" client "sudo sail spec create -p acme --id after-api --title 'after sail-api restarted'"
  check "$run" "it reaches main within 30 s, no sail sync asked" reaches_main_unasked "$run" after-api
  check "$run" "the pty host restarts on client" on "$run" client "sudo systemctl restart sail-pty-host"
  check "$run" "the session outlives the pty host's restart" session_is "$run" client ticker live
  check "$run" "incus restarts on client" on "$run" client "sudo systemctl restart incus"
  check "$run" "the session incus ended reads as ended" session_is "$run" client ticker ended
  check "$run" "client opens a new session in acme, attaches and detaches" opens_session "$run" client ticker2
  check "$run" "the new session is live" session_is "$run" client ticker2 live
  check "$run" "inside client's acme, spec whoami still answers" \
    container_allows "$run" client acme "spec whoami | grep -q '\"handle\": \"client\"'"
  check "$run" "client writes a spec with no sync after incus restarted" \
    allowed "$run" client "sudo sail spec create -p acme --id after-incus --title 'after incus restarted'"
  check "$run" "that one reaches main within 30 s too" reaches_main_unasked "$run" after-incus
}

copies_main() {
  local run=$1 copy=$2
  on "$run" main "sudo apt-get install -y -qq sqlite3 > /dev/null 2>&1 && sudo sqlite3 /var/lib/sail/sail.db '.backup /root/sail.db.copy' && sudo install -m 600 -o \$(id -un) /root/sail.db.copy /tmp/sail.db.copy" || return 1
  (umask 077 && gc compute scp "$(vm "$run" main):/tmp/sail.db.copy" "$copy" --zone "$ZONE") || return 1
  ls -l "$copy"
}

holds_spec() {
  local run=$1 spec=$2 box
  shift 2
  for box in "$@"; do
    on "$run" "$box" "sudo sail spec show $spec --no-sync" > /dev/null || { echo "$box does not hold $spec"; return 1; }
    echo "$box holds $spec"
  done
}

loses_main() {
  gc compute instances delete "$(vm "$1" main)" --zone "$ZONE"
}

brings_up_main() {
  create_vm "$1" main && answers_ssh "$1" main
}

pins_main() {
  local run=$1 box=$2 main_ip=$3 out pinned
  out=$(on "$run" "$box" "sudo ssh-keygen -R $main_ip; sudo sail init --main $main_ip" 2>&1)
  echo "$out" | tee "$(log_dir "$run")/pin-$box.out"
  pinned=$(on "$run" main "sudo ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub" | awk '{print $2}')
  echo "main's own fingerprint: $pinned"
  [[ -n $pinned ]] && grep -qF "Pinned main's host key $pinned" <<< "$out"
}

admits_on_empty_main() {
  local run=$1 box=$2 role=$3 line
  line=$(grep -m1 -oE "sudo sail fde add .*" "$(log_dir "$run")/pin-$box.out" | sed -E "s/--role [a-z]+/--role $role/")
  [[ -n $line ]] || { echo "$box's init printed no fde add line"; return 1; }
  on "$run" main "$line"
}

restores_copy() {
  local run=$1 copy=$2 out
  gc compute scp "$copy" "$(vm "$run" main):/tmp/sail.db.copy" --zone "$ZONE" || return 1
  out=$(on "$run" main "sudo install -m 600 /tmp/sail.db.copy /root/sail.db.copy && rm -f /tmp/sail.db.copy && sudo systemctl stop sail-api && sudo install -m 660 -g sail /root/sail.db.copy /var/lib/sail/sail.db && sudo rm -f /var/lib/sail/sail.db-wal /var/lib/sail/sail.db-shm && sudo sail migrate && sudo systemctl start sail-api" 2>&1)
  echo "$out"
  grep -qF "API token re-issued for this box: the database came from another box." <<< "$out"
}

drops_what_main_lost() {
  local run=$1 box=$2 spec=$3 said
  said=$({
    cat "$(log_dir "$run")/pin-$box.out"
    on "$run" "$box" "sudo sail sync" 2>&1
    on "$run" "$box" "sudo journalctl -u sail-api --since '-20min' --no-pager -o cat"
  })
  grep -F "main no longer holds" <<< "$said"
  grep -qF "main no longer holds 1 spec(s) this box had pulled ($spec): main was restored from a copy older than this box's last sync" <<< "$said"
}

lost_but_in_history() {
  local run=$1 spec=$2 box
  shift 2
  for box in "$@"; do
    if on "$run" "$box" "sudo sail spec show $spec --no-sync" > /dev/null 2>&1; then
      echo "$box still holds $spec"
      return 1
    fi
    on "$run" "$box" "sudo sail spec history $spec" || { echo "$box has no history of $spec"; return 1; }
  done
}

rebuilt() {
  local run=${1:-} version copy main_ip box
  version=$(from_caller "${2:-}")
  [[ -n $run && -n $version ]] || usage
  copy="$(log_dir "$run")/main.db.copy"
  trap "rm -f $(printf %q "$copy")" EXIT
  check "$run" "every node syncs twice before main is copied" sync_all "$run"
  check "$run" "main is copied by the README's backup line, and the copy is kept off the box" copies_main "$run" "$copy"
  check "$run" "main takes a spec after its copy" \
    allowed "$run" main "sudo sail spec create -p acme --id after-copy --title 'main took this after its copy'"
  check "$run" "every node syncs twice to pull it" sync_all "$run"
  check "$run" "every node holds it" holds_spec "$run" after-copy eng client observer
  check "$run" "main is lost: its VM is deleted" loses_main "$run"
  check "$run" "client writes a spec while main is gone" \
    allowed "$run" client "sudo sail spec create -p acme --id while-main-gone --title 'client wrote this while main was gone'"
  check "$run" "a new main comes up in its place" brings_up_main "$run"
  check "$run" "install $version on the new main" install_box "$run" main "$version"
  check "$run" "the new main inits empty, as uday" init_main "$run"
  main_ip=$(internal_ip "$run" main)
  check "$run" "observer pins the empty main and checks its fingerprint" pins_main "$run" observer "$main_ip"
  check "$run" "the empty main admits obs as a viewer" admits_on_empty_main "$run" observer viewer
  check "$run" "observer will not sync with the empty main, another org" \
    refused "$run" observer "is not the database this box synced with" "sudo sail sync"
  check "$run" "the copy goes in place by the README, and migrate re-issues the API token" restores_copy "$run" "$copy"
  rm -f "$copy"
  check "$run" "spec list works on the new main" allowed "$run" main "sudo sail spec list --all-projects"
  check "$run" "main's roster is the copy's" roster "$run"
  for box in eng client observer; do
    check "$run" "$box pins the new main and checks its fingerprint" pins_main "$run" "$box" "$main_ip"
  done
  for box in eng client observer; do
    check "$run" "$box drops after-copy, which main lost, and says so" drops_what_main_lost "$run" "$box" after-copy
  done
  check "$run" "every node syncs twice" sync_all "$run"
  check "$run" "main holds the spec client wrote while it was gone" holds_spec "$run" while-main-gone main eng observer
  check "$run" "after-copy is gone from every box, and stays in each node's history" \
    lost_but_in_history "$run" after-copy eng client observer
  check "$run" "eng still holds every project" holds "$run" eng "acme beta demo gamma"
  check "$run" "client still holds acme alone" holds "$run" client "acme"
  check "$run" "observer still holds acme and beta" holds "$run" observer "acme beta"
  check "$run" "every box still holds shared with eng's title" everywhere "$run" shared title "eng renamed it"
  check "$run" "acme-chat still reads the same on every box" conversation_matches "$run" acme-chat
  check "$run" "every box still reads client's notes.md" file_everywhere "$run" acme notes.md "acme notes v2" main eng client observer
  check "$run" "client writes a spec with no sync after the rebuild" \
    allowed "$run" client "sudo sail spec create -p acme --id after-rebuild --title 'after main was rebuilt'"
  check "$run" "it reaches the new main within 30 s, no sail sync asked" reaches_main_unasked "$run" after-rebuild
}

secret() { gc secrets versions access latest --secret "$1"; }

place_secret() {
  secret "$3" | on "$1" "$2" "sudo sh -c 'umask 077; mkdir -p /root/.fleet; cat > /root/.fleet/$4; test -s /root/.fleet/$4'"
}

no_secret_in_logs() {
  local run=$1 dir name leaked=0
  dir=$(log_dir "$run")
  for name in $SECRETS; do
    if grep -rqF -f <(secret "$name") "$dir"; then
      echo "$name appears in $dir: its logs are deleted"
      leaked=1
    fi
  done
  if [[ $leaked == 1 ]]; then
    rm -f "$dir"/*.log "$dir"/report.txt
    return 1
  fi
  echo "no secret appears in $dir"
}

registers_container_key() {
  on "$1" "$2" 'test -f ~/.ssh/fleet_container || ssh-keygen -q -t ed25519 -N "" -f ~/.ssh/fleet_container; sudo sail host config set ssh-public-key "$(cat ~/.ssh/fleet_container.pub)"'
}

applies_with_forge_token() {
  on "$1" "$2" "sudo sh -c 'GITHUB_TOKEN=\$(cat /root/.fleet/gh) sail project apply $3 --yes'"
}

container_ip() {
  on "$1" "$2" "sudo sail project connect $3 2>/dev/null" | awk -v h="$3" '$1 == "Host" {in_host = ($2 == h)} in_host && $1 == "HostName" {print $2; exit}'
}

in_container_ssh() {
  local run=$1 box=$2 project=$3 ip
  shift 3
  ip=$(container_ip "$run" "$box" "$project" < /dev/null)
  [[ -n $ip ]] || { echo "no container address for $project"; return 1; }
  on "$run" "$box" "ssh -i ~/.ssh/fleet_container -o BatchMode=yes -o StrictHostKeyChecking=accept-new dev@$ip '$*'"
}

gives_agents_their_keys() {
  local run=$1 box=$2 project=$3 login=''
  [[ " $LOOP_AGENTS " == *" codex "* ]] && login='printf %s "$OPENAI_API_KEY" | codex login --with-api-key >/dev/null && '
  {
    printf 'export ANTHROPIC_API_KEY=%s\n' "$(secret fleet-anthropic-key)"
    printf 'export OPENAI_API_KEY=%s\n' "$(secret fleet-openai-key)"
  } | in_container_ssh "$run" "$box" "$project" \
    'umask 077; cat > ~/.agent-keys; grep -q agent-keys ~/.profile || printf "\n[ -f ~/.agent-keys ] && . ~/.agent-keys\n" >> ~/.profile; test -s ~/.agent-keys || { echo no keys arrived; exit 1; }; . ~/.profile; '"$login"'echo keys placed'
}

agent_answers() {
  local asks out
  case $4 in
    claude-code) asks='claude -p \"Reply with the single word ready\"' ;;
    codex) asks='codex exec --skip-git-repo-check \"Reply with the single word ready\"' ;;
    *) echo "no way to ask $4"; return 1 ;;
  esac
  out=$(in_container_ssh "$1" "$2" "$3" "bash -lc \"$asks 2>&1 | tail -6\"" < /dev/null)
  echo "$4: $out"
  grep -qi '^ready' <<< "$out"
}

agents_answer() {
  local agent
  for agent in $LOOP_AGENTS; do
    agent_answers "$1" "$2" "$3" "$agent" || return 1
  done
}

install_list() {
  local agent json=""
  for agent in $LOOP_AGENTS; do
    json+="${json:+,}\"$agent\""
  done
  echo "$json"
}

reaches_status() {
  local run=$1 box=$2 spec=$3 wanted=$4 minutes=$5 status last="" i
  for i in $(seq 1 $((minutes * 2))); do
    status=$(spec_field "$run" "$box" "$spec" status)
    [[ $status != "$last" ]] && echo "$(date -u +%H:%M:%S) $status" && last=$status
    [[ $status == "$wanted" ]] && return 0
    [[ $status == cancelled || $status == archived ]] && return 1
    sleep 30
  done
  echo "not $wanted after $minutes min"
  return 1
}

opened_a_pull_request() {
  local listed
  listed=$(GH_TOKEN=$(secret fleet-github-token) gh pr list --repo "$LOOP_REPO" --head "agent/$1" --json number,title,url --jq '.[] | "#\(.number) \(.title) \(.url)"')
  echo "$listed"
  [[ -n $listed ]]
}

waits_on_its_question() {
  local run=$1 box=$2 spec=$3 minutes=$4 said i
  for i in $(seq 1 $((minutes * 2))); do
    said=$(on "$run" "$box" "sudo sail spec comments $spec --no-sync")
    if grep -q "ended on its question" <<< "$said"; then
      echo "$said" | tail -6
      [[ $(spec_field "$run" "$box" "$spec" status) == in_progress ]]
      return
    fi
    sleep 30
  done
  echo "no question held the build after $minutes min"
  return 1
}

the_room_shows_the_review() {
  local said
  said=$(on "$1" "$2" "sudo sail spec comments $3 --no-sync")
  echo "$said" | tail -20
  grep -qi review <<< "$said"
}

measures_match_the_rows() {
  local run=$1 spec=$2 shown reviews runs
  shown=$(on "$run" main "sudo sail spec show $spec --no-sync --json") || return 1
  reviews=$(on "$run" main "sudo sail agent review acme --spec $spec --json") || return 1
  runs=$(on "$run" main "sudo sail agent sessions acme --json") || return 1
  python3 -I -c '
import json, sys
spec = sys.argv[1]
rework = json.loads(sys.argv[2])["measures"]["rework"]
listed = json.loads(sys.argv[3]).get(spec, {}).get("reviews", [])
rounds = len([r for r in listed if "error" not in r and r["status"] in ("passed", "failed", "escalated")])
errors = len([r for r in listed if "error" in r])
builds = len({r["id"] for r in json.loads(sys.argv[4]).get("runs", [])
              if r.get("spec_id") == spec and r.get("role") == "build"})
served = tuple(rework[k].get("count") for k in ("review_rounds", "review_errors", "build_runs"))
print("measures: rounds, errors, build runs %s, exact: %s; listed: %d, %d, %d"
      % (served, not any("at_least" in rework[k] for k in rework), rounds, errors, builds))
exact = not any("at_least" in rework[k] or "unknown" in rework[k] for k in rework)
sys.exit(0 if rounds > 0 and exact and served == (rounds, errors, builds) else 1)
' "$spec" "$shown" "$reviews" "$runs"
}

closes_the_pull_request() {
  local number
  number=$(GH_TOKEN=$(secret fleet-github-token) gh pr list --repo "$LOOP_REPO" --head "agent/$1" --json number --jq '.[0].number')
  [[ -z $number ]] && { echo "no pull request to close"; return 0; }
  GH_TOKEN=$(secret fleet-github-token) gh pr close "$number" --repo "$LOOP_REPO" --delete-branch --comment "Closed by ci/fleet run $2: the fleet proves the loop, nothing here merges."
}

readonly LOOP_BODY='# The build passes on JDK 21, and the README says how to run it

Before you change anything, ask in this spec'"'"'s conversation, as a question
(`spec comment <this spec'"'"'s id> --question --body -`), whether the new README section should be
titled "Building" or "Build", and end your turn there without changing anything. Go on only once
the answer is in the conversation.

`mvn -q verify` fails on JDK 21: the SpotBugs Maven plugin in pom.xml bundles an ASM that cannot
read Java 21 class files. Move it to a release that can, so `mvn -q verify` from the repository
root passes on JDK 21. Then add the section to README.md, titled as the answer says, after its introduction, saying
that `mvn -q verify` builds and tests every module and that the build needs JDK 21. Run
`mvn -q verify` yourself and say in the pull request that it passed. Change only pom.xml and
README.md.'

loop() {
  local run=${1:-} spec
  [[ -n $run ]] || usage
  spec="loop-$(date -u +%H%M%S)"
  check "$run" "main gives acme the nocaptcha repo, JDK 21 and Maven" \
    on "$run" main "echo '[{\"url\":\"https://github.com/$LOOP_REPO.git\",\"path\":\"nocaptcha\"}]' | sudo sail project config set acme repos - && echo '{\"jdk\":21,\"maven\":\"3.9.9\"}' | sudo sail project config set acme runtimes -"
  check "$run" "main installs $LOOP_AGENTS, the first to build and the next to review, naming no flag" \
    on "$run" main "echo '{\"type\":\"${LOOP_AGENTS%% *}\",\"install\":[$(install_list)]}' | sudo sail project config set acme agent -"
  check "$run" "every node syncs twice" sync_all "$run"
  check "$run" "eng holds the forge token where only root reads it" place_secret "$run" eng fleet-github-token gh
  check "$run" "eng registers its workstation key" registers_container_key "$run" eng
  check "$run" "eng applies acme with the forge token" applies_with_forge_token "$run" eng acme
  check "$run" "acme's agents get their keys through their own login" gives_agents_their_keys "$run" eng acme
  check "$run" "each installed agent answers" agents_answer "$run" eng acme
  check "$run" "no secret appears in the run's logs" no_secret_in_logs "$run"
  check "$run" "eng writes a spec for the loop" \
    on "$run" eng "cat > /tmp/loop.md && sudo sail spec create -p acme --id $spec --title 'The build passes on JDK 21 and the README says how to run it' --body-file /tmp/loop.md --assignee eng" <<< "$LOOP_BODY"
  check "$run" "eng makes it ready" on "$run" eng "sudo sail spec update $spec --status pending"
  check "$run" "eng dispatches it in the background" on "$run" eng "sudo sail spec dispatch -p acme --spec $spec --background"
  check "$run" "the build asks its question and waits, unreviewed" waits_on_its_question "$run" eng "$spec" 20
  check "$run" "eng answers in the room" on "$run" eng "sudo sail spec comment $spec --body 'Call it Building.'"
  check "$run" "the answer resumes the build, and the review takes it to awaiting_merge" reaches_status "$run" eng "$spec" awaiting_merge 45
  check "$run" "the agent opened a pull request on $LOOP_REPO" opened_a_pull_request "$spec"
  check "$run" "the room shows the review" the_room_shows_the_review "$run" eng "$spec"
  check "$run" "every node syncs twice" sync_all "$run"
  check "$run" "every box sees it awaiting merge" everywhere "$run" "$spec" status awaiting_merge
  check "$run" "main's measures of it count the reviews and the build runs listed for it" measures_match_the_rows "$run" "$spec"
  check "$run" "the fleet closes its pull request and deletes the branch" closes_the_pull_request "$spec" "$run"
  check "$run" "still no secret appears in the run's logs" no_secret_in_logs "$run"
}

runs_version() {
  local run=$1 box=$2 expected=$3 printed
  printed=$(on "$run" "$box" "sail -V")
  echo "$box runs: $printed, expected: $expected"
  [[ $printed == "$expected" ]]
}

runs_binary() {
  local run=$1 box=$2 expected=$3 installed
  installed=$(on "$run" "$box" 'sudo sha256sum "$(command -v sail)"' | awk '{print $1}')
  echo "$box runs sha256 $installed, expected $expected"
  [[ $installed == "$expected" ]]
}

upgrade_box() {
  local run=$1 box=$2 target=$3
  if [[ -f $target ]]; then
    gc compute scp "$target" "$(vm "$run" "$box"):/tmp/sail-candidate" --zone "$ZONE"
    on "$run" "$box" "sudo sail upgrade --binary /tmp/sail-candidate"
  else
    on "$run" "$box" "sudo sail upgrade --target $target"
  fi
}

upgrade() {
  local run=${1:-} target box expected
  target=$(from_caller "${2:-}")
  [[ -n $run && -n $target ]] || usage
  for box in main eng client observer; do
    check "$run" "$box upgrades to $target" upgrade_box "$run" "$box" "$target"
    if [[ -f $target ]]; then
      expected=$(sha256sum "$target" | awk '{print $1}')
      check "$run" "$box runs the candidate ${expected:0:12}" runs_binary "$run" "$box" "$expected"
    else
      expected="sail $target"
      check "$run" "$box runs $expected" runs_version "$run" "$box" "$expected"
    fi
  done
  check "$run" "every node syncs twice after the upgrade" sync_all "$run"
  check "$run" "eng still holds every project" holds "$run" eng "acme beta demo gamma"
  check "$run" "client still holds acme alone" holds "$run" client "acme"
  check "$run" "observer still holds acme and beta" holds "$run" observer "acme beta"
  check "$run" "every box still holds shared with eng's title" everywhere "$run" shared title "eng renamed it"
  check "$run" "every box still holds its priority" everywhere "$run" shared priority 7
  check "$run" "its conversation still reads the same on every box" conversation_matches "$run" shared
}

down() {
  local run=${1:-} filter="labels.purpose=sail-fleet"
  [[ -n $run ]] && filter="$filter AND labels.run=$run"
  local names
  names=$(gc compute instances list --filter="$filter" --format='value(name)')
  [[ -z $names ]] && { echo "No fleet VMs to delete."; return; }
  gc compute instances delete $names --zone "$ZONE" > /dev/null
  echo "Deleted: $names"
}

status=0

step() {
  [[ $status == 0 ]] || return 0
  "$@" || status=1
  if grep -q '^FAIL' "$RUNS/$2/report.txt" 2>/dev/null; then
    status=1
  fi
}

run() {
  local version=${1:-} target=""
  [[ -n $version ]] || usage
  if [[ ${2:-} == --upgrade-to ]]; then
    target=${3:-}
    [[ -n $target ]] || usage
  fi
  local id
  id="r$(date -u +%Y%m%d-%H%M%S)"
  echo "Fleet run $id on $version${target:+, upgraded to $target}; logs in $RUNS/$id"
  status=0
  step up "$id"
  step install "$id" "$version"
  step join "$id"
  step projects "$id"
  if [[ -n $target ]]; then
    step conflicts "$id"
    step upgrade "$id" "$target"
  fi
  step doors "$id"
  step inside "$id"
  [[ -n $target ]] || step conflicts "$id"
  step rooms "$id"
  step access "$id"
  step files "$id"
  step portal "$id"
  step resilience "$id"
  [[ ${FLEET_LOOP:-1} == 0 ]] || step loop "$id"
  step rebuilt "$id" "${target:-$version}"
  if [[ ${FLEET_KEEP:-0} != always && ( $status == 0 || ${FLEET_KEEP:-0} != 1 ) ]]; then
    down "$id"
  else
    echo "Kept $id for diagnosis: ci/fleet down $id when done."
  fi
  echo "--- $RUNS/$id/report.txt"
  cat "$RUNS/$id/report.txt"
  return $status
}

case ${1:-} in
  run) shift; run "$@" ;;
  up) shift; up "$@" ;;
  install) shift; install "$@" ;;
  join) shift; join "$@" ;;
  projects) shift; projects "$@" ;;
  doors) shift; doors "$@" ;;
  upgrade) shift; upgrade "$@" ;;
  inside) shift; inside "$@" ;;
  conflicts) shift; conflicts "$@" ;;
  rooms) shift; rooms "$@" ;;
  access) shift; access "$@" ;;
  files) shift; files "$@" ;;
  portal) shift; portal "$@" ;;
  resilience) shift; resilience "$@" ;;
  loop) shift; loop "$@" ;;
  rebuilt) shift; rebuilt "$@" ;;
  ssh) shift; [[ $# -ge 3 ]] || usage; r=$1 b=$2; shift 2; on "$r" "$b" "$@" ;;
  down) shift; down "$@" ;;
  *) usage ;;
esac
