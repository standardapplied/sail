#!/usr/bin/env bash
set -euo pipefail

# Which lanes a change can affect, as lines for GITHUB_OUTPUT: clients for the Clients workflow;
# terminal for CI's native build and terminal end to end; ci for CI's other lanes. EVENT is the
# GitHub event, BASE the commit the change is measured from (a pull request's base, a push's
# before), in the repository of the working directory.
#
# The client lanes read clients/ (SailApp's one dependency is ../SailKit by path), the Clients
# workflow, this script, and what the darwin sail they test against and bundle is built from: the
# build files, the Java modules' main sources, and the Maven cache action its build job uses. No CI lane reads the app, the changelog or its changes/, the
# architecture or the Clients workflow (README.md and install.sh are read by unit tests). Of
# SailKit, the terminal lane builds all of it and the unit lanes read only its goldens
# (ClientGoldensTest). A rename counts as both of its paths. CI narrows only a pull request; a
# push, a dispatch, an empty change or one that cannot be computed runs every lane.

readonly CLIENTS='^(clients/|\.github/workflows/clients\.yml$|ci/changes$|pom\.xml$|sail-[^/]+/(pom\.xml$|src/main/)|\.github/actions/maven-cache/)'
readonly NO_CI_LANE='^(clients/SailApp/|CHANGELOG\.md$|changes/|ARCHITECTURE\.md$|\.github/workflows/clients\.yml$)'
readonly SAILKIT='^clients/SailKit/'
readonly GOLDENS='^clients/SailKit/Tests/Goldens/'

everything() {
  echo "ci/changes: $1; every lane runs." >&2
  echo clients=true
  echo ci=true
  echo terminal=true
  exit 0
}

event=${1:-}
base=${2:-}
[[ $event == pull_request || $event == push ]] || everything "a ${event:-nameless} run is never narrowed"
changed=$(git diff --no-renames --name-only "$base" HEAD 2> /dev/null) || everything "no diff from '$base'"
[[ -n $changed ]] || everything "nothing changed from $base"

clients=false
ci=false
terminal=false
while IFS= read -r path; do
  if [[ $path =~ $CLIENTS ]]; then
    clients=true
  fi
  if [[ $event == push ]]; then
    ci=true
    terminal=true
  elif [[ ! $path =~ $NO_CI_LANE ]]; then
    terminal=true
    if [[ ! $path =~ $SAILKIT || $path =~ $GOLDENS ]]; then
      ci=true
    fi
  fi
done <<< "$changed"

echo "clients=$clients"
echo "ci=$ci"
echo "terminal=$terminal"
