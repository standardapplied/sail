#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

readonly MODULES="sail-core sail-harness sail-infra"
readonly DEFAULT_IT_SECONDS=10
readonly SPLIT_IT_SECONDS=360
usage() {
  cat >&2 <<'EOF'
Usage:
  ci/check                      format, then run the tests of classes changed against origin/main
  ci/check quick                format, then every module's unit tests, incrementally and without coverage
  ci/check full                 every module's tests and gates, as CI's unit jobs run them together
  ci/check unit MODULE [--tests-only]
                                one module's tests and gates, its upstream installed first; sail-infra's
                                adds the architecture rules, the duplication report and ci/exclusions;
                                --tests-only runs the tests alone, without coverage or quality gates
  ci/check shard INDEX COUNT [EXCLUDED_IT...]
                                print the IT classes of shard INDEX (1-based) of COUNT
  ci/check its INDEX COUNT [EXCLUDED_IT...] -- [MAVEN_ARG...]
                                run the IT classes of that shard under -Pintegration
  ci/check methods CLASS INDEX COUNT
                                print CLASS#a+b+... : every COUNT-th of its @Test methods from INDEX
  ci/check local-host BINARY    run BINARY's own terminal host as the app's agent does, in this
                                account's home, which must hold none: it serves, a second exits 1
                                naming it, and SIGTERM stops it leaving only its lock
  ci/check min-macos BINARY     fail unless the darwin BINARY's minimum macOS (its Mach-O
                                LC_BUILD_VERSION) is no newer than the app's LSMinimumSystemVersion
  ci/check exclusions [BASE]    fail if a Java line could silence PMD or CPD, or if the PMD exclusions
                                name a class=rule pair BASE's do not (default: where it left
                                origin/main), a class twice, or a line that is not a comment, blank
                                or one Class=Rule[,Rule] entry (ci/exclusions)
  ci/check rules [BASE]         fail on a finding of every rule ci/rules has on, or on a rule not yet
                                on that finds nothing; with BASE, a pull request's base, also on its
                                entry: changes/<name>.md of its branch agent/<name> neither added
                                nor edited, another added or one deleted, an edit of CHANGELOG.md,
                                or one the release could not fold
                                (ci/rules check, ci/changelog check)
EOF
  exit 2
}

upstream_of() {
  local module=$1 upstream="" candidate
  for candidate in $MODULES; do
    [[ $candidate == "$module" ]] && break
    upstream="${upstream:+$upstream,}$candidate"
  done
  echo "$upstream"
}

require_module() {
  local module=$1 candidate
  for candidate in $MODULES; do
    [[ $candidate == "$module" ]] && return
  done
  echo "ci/check: '$module' is not one of $MODULES." >&2
  exit 2
}

unit() {
  local module=${1:-} gates=true
  [[ -n $module ]] || usage
  require_module "$module"
  case ${2:-} in
    "") ;;
    --tests-only) gates=false ;;
    *) usage ;;
  esac
  local upstream upstream_pmd=-Dpmd.skip=true
  upstream=$(upstream_of "$module")
  if $gates && [[ $module == sail-infra ]]; then
    upstream_pmd=-Dpmd.failOnViolation=false
  fi
  if [[ -n $upstream ]]; then
    mvn -B -q install -pl "$upstream" -am -DskipTests -Djacoco.skip=true -Dspotless.check.skip=true \
      -Dcpd.skip=true "$upstream_pmd"
  fi
  if ! $gates; then
    mvn -B verify -pl "$module" -Djacoco.skip=true -Dpmd.skip=true -Dcpd.skip=true
  elif [[ $module == sail-infra ]]; then
    ci/exclusions
    mvn -B verify -pl sail-infra,architecture
    mvn -B pmd:aggregate-cpd@cpd pmd:aggregate-cpd-check@cpd-check
  else
    mvn -B verify -pl "$module"
  fi
}

quick() {
  mvn -B -q spotless:apply
  mvn -B verify -Djacoco.skip=true
}

full() {
  ci/exclusions
  mvn -B clean verify
}

it_classes() {
  local excluded=" $* "
  grep -rLE --include='*IT.java' '^(public )?abstract class [A-Za-z0-9_]+IT\b' sail-*/src/test/java \
    | sed -E 's#.*/([^/]+)\.java$#\1#' \
    | while read -r name; do
        [[ $excluded == *" $name "* ]] || echo "$name"
      done \
    | sort
}

# Each IT class with its recorded cost, a class over SPLIT_IT_SECONDS as that many parts of its
# methods (`methods`), each "Class#a+b+..." costing its share, so no one class outlasts a shard.
it_units() {
  local cost class parts part
  it_classes "$@" \
    | awk -v fallback="$DEFAULT_IT_SECONDS" '
        NR == FNR { seconds[$2] = $1; next }
        { cost = ($1 in seconds) ? seconds[$1] : fallback; print cost, $1 }
      ' ci/it-seconds - \
    | while read -r cost class; do
        if (( cost <= SPLIT_IT_SECONDS )); then
          echo "$cost $class"
          continue
        fi
        parts=$(( (cost + SPLIT_IT_SECONDS - 1) / SPLIT_IT_SECONDS ))
        for part in $(seq 1 "$parts"); do
          echo "$(( cost / parts )) $(methods "$class" "$part" "$parts")"
        done
      done
}

shard() {
  local index=${1:-} count=${2:-}
  [[ $index =~ ^[1-9][0-9]*$ && $count =~ ^[1-9][0-9]*$ && $index -le $count ]] || usage
  shift 2
  it_units "$@" \
    | sort -k1,1nr -k2,2 \
    | awk -v index_="$index" -v count="$count" '
        {
          best = 1
          for (i = 2; i <= count; i++) if (load[i] < load[best]) best = i
          load[best] += $1
          if (best == index_) members = members (members ? "," : "") $2
        }
        END { print members }
      '
}

its() {
  [[ $# -ge 2 ]] || usage
  local index=$1 count=$2 excluded=""
  shift 2
  while [[ $# -gt 0 && $1 != -- ]]; do
    excluded="$excluded $1"
    shift
  done
  [[ $# -gt 0 ]] && shift
  local members
  members=$(shard "$index" "$count" $excluded)
  if [[ -z $members ]]; then
    echo "ci/check: shard $index of $count holds no IT class." >&2
    exit 1
  fi
  echo "Shard $index of $count: $members"
  mvn -B -Pintegration verify \
    -Dit.test="$members" \
    -Dfailsafe.failIfNoSpecifiedTests=false \
    -Dtest=NoUnitTests \
    -Dsurefire.failIfNoSpecifiedTests=false \
    -Djacoco.skip=true \
    -Dspotless.check.skip=true \
    -Dpmd.skip=true \
    -Dcpd.skip=true \
    "$@"
}

methods() {
  local class=${1:-} index=${2:-} count=${3:-}
  [[ -n $class && $index =~ ^[1-9][0-9]*$ && $count =~ ^[1-9][0-9]*$ && $index -le $count ]] || usage
  local file
  file=$(find sail-*/src/test/java -name "$class.java" | head -1)
  if [[ -z $file ]]; then
    echo "ci/check: no test class $class." >&2
    exit 2
  fi
  local annotated all picked
  annotated=$(grep -cE '^[[:space:]]*@(Test|ParameterizedTest|RepeatedTest|TestFactory|TestTemplate)\b' "$file" || true)
  all=$(awk '/^[[:space:]]*@(Test|ParameterizedTest|RepeatedTest|TestFactory|TestTemplate)([^A-Za-z]|$)/ { test = 1 }
             test {
               line = $0
               gsub(/@[A-Za-z0-9_.]+(\([^)]*\))?/, "", line)
               if (match(line, /[A-Za-z0-9_]+[[:space:]]*\(/)) {
                 name = substr(line, RSTART, RLENGTH)
                 sub(/[[:space:]]*\($/, "", name)
                 print name
                 test = 0
               }
             }' "$file")
  if [[ $(printf '%s\n' "$all" | grep -c .) != "$annotated" ]]; then
    echo "ci/check: $class has $annotated tests but $(printf '%s\n' "$all" | grep -c .) were read; split it by hand." >&2
    exit 1
  fi
  picked=$(printf '%s\n' "$all" \
    | awk -v index_="$index" -v count="$count" '(NR - index_) % count == 0' \
    | paste -sd+ -)
  if [[ -z $picked ]]; then
    echo "ci/check: $class has no test at $index of $count." >&2
    exit 1
  fi
  echo "$class#$picked"
}

LOCAL_HOST_PID=""
LOCAL_HOST_LEFT=()

stop_local_host() {
  if [[ -n $LOCAL_HOST_PID ]]; then
    kill -KILL "$LOCAL_HOST_PID" 2> /dev/null || true
  fi
  rm -rf "${LOCAL_HOST_LEFT[@]}"
}

fail_local_host() {
  echo "ci/check: $1" >&2
  shift
  if [[ $# -gt 0 ]]; then
    cat "$@" >&2
  fi
  exit 1
}

# The account's home is the account database's, so the check runs as this account in its real
# home, only where no local host has been: it removes what it made, ~/.sail too when it made it.
local_host() {
  local sail=${1:-}
  [[ -x $sail ]] || usage
  local sail_dir=$HOME/.sail
  local dir=$sail_dir/local
  [[ ! -e $dir ]] || fail_local_host "$dir is there already; the check runs only where it is not."
  local logs
  logs=$(mktemp -d)
  LOCAL_HOST_LEFT=("$dir" "$logs")
  [[ -e $sail_dir ]] || LOCAL_HOST_LEFT+=("$sail_dir")
  trap stop_local_host EXIT
  "$sail" _pty-host --local 2> "$logs/first" &
  LOCAL_HOST_PID=$!
  local serving="pty-host: serving $(id -un) at $dir/pty.sock" i
  for i in $(seq 1 100); do
    grep -qxF "$serving" "$logs/first" && break
    sleep 0.1
  done
  grep -qxF "$serving" "$logs/first" || fail_local_host "the host never said: $serving" "$logs/first"
  local second=0
  "$sail" _pty-host --local 2> "$logs/second" || second=$?
  [[ $second == 1 ]] || fail_local_host "a second host exited $second, not 1." "$logs/second"
  grep -qxF "A terminal host already serves $(id -un) on this machine, at $dir/pty.sock: connect to it there, or stop it before starting another." "$logs/second" \
    || fail_local_host "a second host did not name the first." "$logs/second"
  kill -TERM "$LOCAL_HOST_PID"
  for i in $(seq 1 100); do
    kill -0 "$LOCAL_HOST_PID" 2> /dev/null || break
    sleep 0.1
  done
  ! kill -0 "$LOCAL_HOST_PID" 2> /dev/null || fail_local_host "SIGTERM did not stop the host within 10 s." "$logs/first"
  local first=0
  wait "$LOCAL_HOST_PID" || first=$?
  LOCAL_HOST_PID=""
  [[ $first == 143 ]] || fail_local_host "the host stopped with exit $first, not 143." "$logs/first"
  [[ $(ls -A "$dir") == pty.lock ]] \
    || fail_local_host "a clean stop left more than the lock: $(ls -A "$dir" | tr '\n' ' ')"
  echo "local-host: ok"
}

# A binary built on a newer macOS than the app supports declares that macOS its minimum: the app
# bundling it, and the CLI a person downloads, would claim a Mac the binary does not.
min_macos() {
  local binary=${1:-}
  [[ -f $binary ]] || usage
  local app minos
  app=$(plutil -extract LSMinimumSystemVersion raw clients/SailApp/ci/Info.plist)
  minos=$(vtool -show-build "$binary" | awk '$1 == "minos" { print $2; exit }')
  [[ -n $minos ]] || { echo "min-macos: $binary names no minimum macOS (no LC_BUILD_VERSION)" >&2; exit 1; }
  if (( $(version_key "$minos") > $(version_key "$app") )); then
    echo "min-macos: $binary needs macOS $minos, newer than the app's minimum, macOS $app: build it on macOS $app" >&2
    exit 1
  fi
  echo "min-macos: $binary needs macOS $minos; the app supports macOS $app: ok"
}

# A dotted version as one number that orders as the version does: 15.0 and 15.0.0 are equal.
version_key() {
  awk -F. '{ printf "%d%03d%03d\n", $1, $2, $3 }' <<< "$1"
}

changed_tests() {
  local base
  base=$(git merge-base origin/main HEAD)
  { git diff --name-only "$base"; git ls-files --others --exclude-standard; } \
    | { grep -E '^sail-[a-z]+/src/(main|test)/java/.+\.java$' || true; } \
    | sort -u \
    | while read -r path; do
        [[ -f $path ]] || continue
        local name
        name=$(basename "$path" .java)
        if [[ $path == */src/test/* ]]; then
          [[ $name == *Test ]] && echo "$name"
        else
          echo "${name}*Test"
        fi
      done \
    | sort -u \
    | paste -sd, -
}

# The PMD exclusions only shrink (ci/exclusions).
exclusions() {
  ci/exclusions "$@"
}

# The rules a script decides, in seconds (ci/rules); with a pull request's base, its entry too.
rules() {
  ci/rules check "$@"
}

changed() {
  rules
  mvn -B -q spotless:apply
  local tests
  tests=$(changed_tests)
  if [[ -z $tests ]]; then
    echo "ci/check: no Java class changed against origin/main; nothing to test."
    return
  fi
  echo "Testing: $tests"
  mvn -B test -Dtest="$tests" -Dsurefire.failIfNoSpecifiedTests=false -Djacoco.skip=true
}

case ${1:-} in
  "") changed ;;
  quick) quick ;;
  full) full ;;
  unit) shift; unit "$@" ;;
  shard) shift; shard "$@" ;;
  its) shift; its "$@" ;;
  methods) shift; methods "$@" ;;
  local-host) shift; local_host "$@" ;;
  min-macos) shift; min_macos "$@" ;;
  exclusions) shift; exclusions "$@" ;;
  rules) shift; rules "$@" ;;
  *) usage ;;
esac
